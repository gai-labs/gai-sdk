                        "content": "{\n  \"content\": \"\\\"\\\"\\\"\\nUnit tests for gai.lib.utils module.\\nTests utility functions for configuration, paths, and async operations.\\n\\\"\\\"\\\"\\nimport pytest\\nimport os\\nimport json\\nimport asyncio\\nimport inspect\\nfrom unittest.mock import patch, mock_open, MagicMock, Mock\\n\\nfrom gai.lib.utils import get_rc, get_app_path, get_here, run_async_function, is_async_generator\\nfrom mocked_objects import MOCK_ENV_VARS, MockFile\\n\\n\\nclass TestGetRc:\\n    @patch('os.path.exists')\\n    @patch('builtins.open', new_callable=mock_open, read_data='{\\\"app_dir\\\": \\\"/mock/app\\\", \\\"other_config\\\": \\\"value\\\"}')\\n    @patch('os.path.expanduser')  \\n    def test_get_rc_success(self, mock_expanduser, mock_file, mock_exists):\\n        \\\"\\\"\\\"Test get_rc when config file exists and is valid.\\\"\\\"\\\"\\n        mock_expanduser.return_value = '/home/user/.gairc'\\n        mock_exists.return_value = True\\n        \\n        result = get_rc()\\n        \\n        assert result == {\\\"app_dir\\\": \\\"/mock/app\\\", \\\"other_config\\\": \\\"value\\\"}\\n        mock_exists.assert_called_once_with('/home/user/.gairc')\\n        mock_file.assert_called_once_with('/home/user/.gairc', 'r')\\n\\n    @patch('os.path.exists')\\n    @patch('os.path.expanduser')\\n    def test_get_rc_file_not_found(self, mock_expanduser, mock_exists):\\n        \\\"\\\"\\\"Test get_rc when config file doesn't exist.\\\"\\\"\\\"\\n        mock_expanduser.return_value = '/home/user/.gairc'\\n        mock_exists.return_value = False\\n        \\n        with pytest.raises(Exception) as exc_info:\\n            get_rc()\\n        \\n        assert \\\"Config file ~/.gairc not found\\\" in str(exc_info.value)\\n        assert \\\"gai init\\\" in str(exc_info.value)\\n\\n    @patch('os.path.exists')\\n    @patch('builtins.open', new_callable=mock_open, read_data='invalid json')\\n    @patch('os.path.expanduser')\\n    def test_get_rc_invalid_json(self, mock_expanduser, mock_file, mock_exists):\\n        \\\"\\\"\\\"Test get_rc when config file contains invalid JSON.\\\"\\\"\\\"\\n        mock_expanduser.return_value = '/home/user/.gairc'\\n        mock_exists.return_value = True\\n        \\n        with pytest.raises(json.JSONDecodeError):\\n            get_rc()\\n\\n    @patch('os.path.exists')\\n    @patch('builtins.open', new_callable=mock_open, read_data='{}')\\n    @patch('os.path.expanduser')\\n    def test_get_rc_empty_config(self, mock_expanduser, mock_file, mock_exists):\\n        \\\"\\\"\\\"Test get_rc with empty JSON config.\\\"\\\"\\\"\\n        mock_expanduser.return_value = '/home/user/.gairc'\\n        mock_exists.return_value = True\\n        \\n        result = get_rc()\\n        \\n        assert result == {}\\n\\n\\nclass TestGetAppPath:\\n    @patch('gai.lib.utils.get_rc')\\n    @patch('os.path.abspath')\\n    @patch('os.path.expanduser')\\n    def test_get_app_path_success(self, mock_expanduser, mock_abspath, mock_get_rc):\\n        \\\"\\\"\\\"Test get_app_path with valid config.\\\"\\\"\\\"\\n        mock_get_rc.return_value = {\\\"app_dir\\\": \\\"~/my_app\\\"}\\n        mock_expanduser.return_value = \\\"/home/user/my_app\\\"\\n        mock_abspath.return_value = \\\"/home/user/my_app\\\"\\n        \\n        result = get_app_path()\\n        \\n        assert result == \\\"/home/user/my_app\\\"\\n        mock_expanduser.assert_called_once_with(\\\"~/my_app\\\")\\n        mock_abspath.assert_called_once_with(\\\"/home/user/my_app\\\")\\n\\n    @patch('gai.lib.utils.get_rc')\\n    def test_get_app_path_missing_app_dir(self, mock_get_rc):\\n        \\\"\\\"\\\"Test get_app_path when app_dir is missing from config.\\\"\\\"\\\"\\n        mock_get_rc.return_value = {\\\"other_config\\\": \\\"value\\\"}\\n        \\n        with pytest.raises(KeyError):\\n            get_app_path()\\n\\n    @patch('gai.lib.utils.get_rc')\\n    @patch('os.path.abspath')\\n    @patch('os.path.expanduser')\\n    def test_get_app_path_with_absolute_path(self, mock_expanduser, mock_abspath, mock_get_rc):\\n        \\\"\\\"\\\"Test get_app_path with absolute path in config.\\\"\\\"\\\"\\n        mock_get_rc.return_value = {\\\"app_dir\\\": \\\"/absolute/path/to/app\\\"}\\n        mock_expanduser.return_value = \\\"/absolute/path/to/app\\\"\\n        mock_abspath.return_value = \\\"/absolute/path/to/app\\\"\\n        \\n        result = get_app_path()\\n        \\n        assert result == \\\"/absolute/path/to/app\\\"\\n\\n\\nclass TestGetHere:\\n    def test_get_here_normal_execution(self):\\n        \\\"\\\"\\\"Test get_here in normal execution context.\\\"\\\"\\\"\\n        # This should return the directory of this test file\\n        result = get_here()\\n        \\n        assert isinstance(result, str)\\n        assert os.path.isabs(result)  # Should be absolute path\\n        # The result should be a valid directory\\n        assert result.endswith('gai-lib') or 'test' in result\\n\\n    @patch('inspect.stack')\\n    @patch('inspect.getmodule')\\n    def test_get_here_with_module_file(self, mock_getmodule, mock_stack):\\n        \\\"\\\"\\\"Test get_here when module has __file__ attribute.\\\"\\\"\\\"\\n        # Mock the call stack - each frame should be a mock frame info object\\n        mock_frame_info = Mock()\\n        mock_frame_info.__getitem__ = Mock(return_value=Mock())  # frame[0] should return frame object\\n        mock_stack.return_value = [Mock(), mock_frame_info]  # [current frame, caller frame]\\n        \\n        # Mock the module with __file__\\n        mock_module = Mock()\\n        mock_module.__file__ = \\\"/path/to/some/script.py\\\"\\n        mock_getmodule.return_value = mock_module\\n        \\n        with patch('os.path.dirname') as mock_dirname, \\\\\\n             patch('os.path.abspath') as mock_abspath:\\n            mock_dirname.return_value = \\\"/path/to/some\\\"\\n            mock_abspath.return_value = \\\"/path/to/some\\\"\\n            \\n            result = get_here()\\n            \\n            assert result == \\\"/path/to/some\\\"\\n            # The actual implementation calls dirname on the abspath result\\n            mock_abspath.assert_called_once_with(\\\"/path/to/some/script.py\\\")\\n            mock_dirname.assert_called_once_with(\\\"/path/to/some\\\")\\n\\n    @patch('inspect.stack')\\n    @patch('inspect.getmodule')\\n    @patch('os.getcwd')\\n    def test_get_here_fallback_to_cwd(self, mock_getcwd, mock_getmodule, mock_stack):\\n        \\\"\\\"\\\"Test get_here fallback when module inspection fails.\\\"\\\"\\\"\\n        # Mock the call stack\\n        mock_frame_info = Mock()\\n        mock_frame_info.__getitem__ = Mock(return_value=Mock())  # frame[0] should return frame object\\n        mock_stack.return_value = [Mock(), mock_frame_info]\\n        \\n        # Mock getmodule to return None (no module found)\\n        mock_getmodule.return_value = None\\n        mock_getcwd.return_value = \\\"/current/working/dir\\\"\\n        \\n        result = get_here()\\n        \\n        assert result == \\\"/current/working/dir\\\"\\n        mock_getcwd.assert_called_once()\\n\\n    @patch('inspect.stack')\\n    @patch('inspect.getmodule')\\n    @patch('os.getcwd')\\n    def test_get_here_module_without_file(self, mock_getcwd, mock_getmodule, mock_stack):\\n        \\\"\\\"\\\"Test get_here when module doesn't have __file__ attribute.\\\"\\\"\\\"\\n        # Mock the call stack\\n        mock_frame_info = Mock()\\n        mock_frame_info.__getitem__ = Mock(return_value=Mock())  # frame[0] should return frame object\\n        mock_stack.return_value = [Mock(), mock_frame_info]\\n        \\n        # Mock module without __file__ attribute\\n        mock_module = Mock(spec=[])  # spec=[] means no __file__ attribute\\n        mock_getmodule.return_value = mock_module\\n        mock_getcwd.return_value = \\\"/current/working/dir\\\"\\n        \\n        result = get_here()\\n        \\n        assert result == \\\"/current/working/dir\\\"\\n        mock_getcwd.assert_called_once()\\n\\n\\nclass TestRunAsyncFunction:\\n    def test_run_async_function_simple_coroutine(self):\\n        \\\"\\\"\\\"Test run_async_function with a simple async function.\\\"\\\"\\\"\\n        async def simple_async():\\n            return \\\"async result\\\"\\n        \\n        result = run_async_function(simple_async)\\n        assert result == \\\"async result\\\"\\n\\n    def test_run_async_function_with_args(self):\\n        \\\"\\\"\\\"Test run_async_function with arguments.\\\"\\\"\\\"\\n        async def async_with_args(x, y, z=None):\\n            return f\\\"{x}-{y}-{z}\\\"\\n        \\n        result = run_async_function(async_with_args, \\\"a\\\", \\\"b\\\", z=\\\"c\\\")\\n        assert result == \\\"a-b-c\\\"\\n\\n    def test_run_async_function_with_exception(self):\\n        \\\"\\\"\\\"Test run_async_function when async function raises exception.\\\"\\\"\\\"\\n        async def failing_async():\\n            raise ValueError(\\\"Async error\\\")\\n        \\n        with pytest.raises(ValueError) as exc_info:\\n            run_async_function(failing_async)\\n        \\n        assert str(exc_info.value) == \\\"Async error\\\"\\n\\n    @patch('asyncio.get_event_loop')\\n    def test_run_async_function_no_running_loop(self, mock_get_event_loop):\\n        \\\"\\\"\\\"Test run_async_function when no event loop is running.\\\"\\\"\\\"\\n        mock_loop = Mock()\\n        mock_loop.is_running.return_value = False\\n        mock_loop.run_until_complete.return_value = \\\"result\\\"\\n        mock_get_event_loop.return_value = mock_loop\\n        \\n        async def test_coro():\\n            return \\\"result\\\"\\n        \\n        result = run_async_function(test_coro)\\n        \\n        assert result == \\\"result\\\"\\n        mock_loop.run_until_complete.assert_called_once()\\n\\n    @patch('asyncio.get_event_loop')\\n    @patch('asyncio.run')\\n    def test_run_async_function_runtime_error_fallback(self, mock_run, mock_get_event_loop):\\n        \\\"\\\"\\\"Test run_async_function fallback when RuntimeError occurs.\\\"\\\"\\\"\\n        mock_get_event_loop.side_effect = RuntimeError(\\\"No event loop\\\")\\n        mock_run.return_value = \\\"fallback result\\\"\\n        \\n        async def test_coro():\\n            return \\\"fallback result\\\"\\n        \\n        result = run_async_function(test_coro)\\n        \\n        assert result == \\\"fallback result\\\"\\n        mock_run.assert_called_once()\\n\\n    @patch('asyncio.get_event_loop')\\n    def test_run_async_function_running_loop_with_nest_asyncio(self, mock_get_event_loop):\\n        \\\"\\\"\\\"Test run_async_function with running loop and nest_asyncio available.\\\"\\\"\\\"\\n        mock_loop = Mock()\\n        mock_loop.is_running.return_value = True\\n        mock_loop.run_until_complete.return_value = \\\"nested result\\\"\\n        mock_get_event_loop.return_value = mock_loop\\n        \\n        # Mock nest_asyncio\\n        with patch('gai.lib.utils.nest_asyncio') as mock_nest_asyncio:\\n            mock_nest_asyncio.apply = Mock()\\n            \\n            async def test_coro():\\n                return \\\"nested result\\\"\\n            \\n            result = run_async_function(test_coro)\\n            \\n            assert result == \\\"nested result\\\"\\n            # Should apply nest_asyncio when loop is running\\n            mock_nest_asyncio.apply.assert_called_once_with(mock_loop)\\n\\n\\nclass TestIsAsyncGenerator:\\n    def test_is_async_generator_with_async_generator(self):\\n        \\\"\\\"\\\"Test is_async_generator with actual async generator.\\\"\\\"\\\"\\n        async def async_gen():\\n            yield 1\\n            yield 2\\n        \\n        gen = async_gen()\\n        result = is_async_generator(gen)\\n        \\n        assert result is True\\n        \\n        # Clean up\\n        gen.aclose()\\n\\n    def test_is_async_generator_with_regular_generator(self):\\n        \\\"\\\"\\\"Test is_async_generator with regular generator.\\\"\\\"\\\"\\n        def regular_gen():\\n            yield 1\\n            yield 2\\n        \\n        gen = regular_gen()\\n        result = is_async_generator(gen)\\n        \\n        assert result is False\\n\\n    def test_is_async_generator_with_async_function(self):\\n        \\\"\\\"\\\"Test is_async_generator with async function (not generator).\\\"\\\"\\\"\\n        async def async_func():\\n            return \\\"not a generator\\\"\\n        \\n        coro = async_func()\\n        result = is_async_generator(coro)\\n        \\n        assert result is False\\n        \\n        # Clean up\\n        coro.close()\\n\\n    def test_is_async_generator_with_regular_function(self):\\n        \\\"\\\"\\\"Test is_async_generator with regular function.\\\"\\\"\\\"\\n        def regular_func():\\n            return \\\"not a generator\\\"\\n        \\n        result = is_async_generator(regular_func())\\n        \\n        assert result is False\\n\\n    def test_is_async_generator_with_list(self):\\n        \\\"\\\"\\\"Test is_async_generator with list.\\\"\\\"\\\"\\n        result = is_async_generator([1, 2, 3])\\n        \\n        assert result is False\\n\\n    def test_is_async_generator_with_none(self):\\n        \\\"\\\"\\\"Test is_async_generator with None.\\\"\\\"\\\"\\n        result = is_async_generator(None)\\n        \\n        assert result is False\\n\\n    def test_is_async_generator_with_mock_async_generator(self):\\n        \\\"\\\"\\\"Test is_async_generator with object that has __aiter__.\\\"\\\"\\\"\\n        class MockAsyncGen:\\n            def __aiter__(self):\\n                return self\\n            \\n            async def __anext__(self):\\n                raise StopAsyncIteration\\n        \\n        mock_gen = MockAsyncGen()\\n        result = is_async_generator(mock_gen)\\n        \\n        assert result is True\\n\\n\\nclass TestUtilsIntegration:\\n    @patch.dict(os.environ, {\\\"HOME\\\": \\\"/home/testuser\\\"})\\n    @patch('os.path.exists')\\n    @patch('builtins.open', new_callable=mock_open, read_data='{\\\"app_dir\\\": \\\"~/test_app\\\"}')\\n    def test_get_rc_and_get_app_path_integration(self, mock_file, mock_exists):\\n        \\\"\\\"\\\"Test integration between get_rc and get_app_path.\\\"\\\"\\\"\\n        mock_exists.return_value = True\\n        \\n        # This should work end-to-end\\n        with patch('os.path.expanduser') as mock_expand, \\\\\\n             patch('os.path.abspath') as mock_abspath:\\n            mock_expand.return_value = \\\"/home/testuser/test_app\\\"\\n            mock_abspath.return_value = \\\"/home/testuser/test_app\\\"\\n            \\n            app_path = get_app_path()\\n            assert app_path == \\\"/home/testuser/test_app\\\"\\n\\n    def test_async_utilities_work_together(self):\\n        \\\"\\\"\\\"Test that async utilities work together properly.\\\"\\\"\\\"\\n        async def test_async_gen():\\n            yield \\\"item1\\\"\\n            yield \\\"item2\\\"\\n        \\n        # Test that we can identify it as async generator\\n        gen = test_async_gen()\\n        assert is_async_generator(gen) is True\\n        \\n        # Test that run_async_function can handle async operations\\n        async def consume_gen():\\n            items = []\\n            async for item in test_async_gen():\\n                items.append(item)\\n            return items\\n        \\n        result = run_async_function(consume_gen)\\n        assert result == [\\\"item1\\\", \\\"item2\\\"]\\n\\n    def test_get_here_consistency(self):\\n        \\\"\\\"\\\"Test that get_here returns consistent results.\\\"\\\"\\\"\\n        # Call multiple times, should return same result\\n        first_call = get_here()\\n        second_call = get_here()\\n        \\n        assert first_call == second_call\\n        assert os.path.isabs(first_call)\\n        \\n    @patch('gai.lib.utils.get_rc')\\n    def test_error_handling_chain(self, mock_get_rc):\\n        \\\"\\\"\\\"Test error handling propagates properly through function chain.\\\"\\\"\\\"\\n        # Make get_rc raise an exception\\n        mock_get_rc.side_effect = Exception(\\\"Config error\\\")\\n        \\n        # get_app_path should propagate this error\\n        with pytest.raises(Exception) as exc_info:\\n            get_app_path()\\n        \\n        assert \\\"Config error\\\" in str(exc_info.value)\"\n}"
