                        "input": {
                            "path": "/workspace/tests/gai-lib/test_prompts.py",
                            "content": "\"\"\"\nUnit tests for gai.lib.prompts module.\nTests prompt utilities for converting between different chat formats.\n\"\"\"\nimport pytest\n\nfrom gai.lib.prompts import (\n    chat_list_to_string,\n    chat_string_to_list,\n    chat_list_to_INST,\n    INST_output_to_output,\n    ASSISTANT_output_to_output\n)\n\n\nclass TestChatListToString:\n    def test_chat_list_to_string_with_valid_list(self):\n        \"\"\"Test chat_list_to_string with valid message list.\"\"\"\n        messages = [\n            {\"role\": \"user\", \"content\": \"Hello\"},\n            {\"role\": \"assistant\", \"content\": \"Hi there!\"},\n            {\"role\": \"user\", \"content\": \"How are you?\"}\n        ]\n        \n        expected = \"user: Hello\\nassistant: Hi there!\\nuser: How are you?\"\n        result = chat_list_to_string(messages)\n        \n        assert result == expected\n\n    def test_chat_list_to_string_with_string_input(self):\n        \"\"\"Test chat_list_to_string when input is already a string.\"\"\"\n        input_string = \"This is already a string\"\n        result = chat_list_to_string(input_string)\n        \n        assert result == input_string\n\n    def test_chat_list_to_string_with_empty_list(self):\n        \"\"\"Test chat_list_to_string with empty list.\"\"\"\n        messages = []\n        result = chat_list_to_string(messages)\n        \n        assert result == \"\"\n\n    def test_chat_list_to_string_with_single_message(self):\n        \"\"\"Test chat_list_to_string with single message.\"\"\"\n        messages = [{\"role\": \"user\", \"content\": \"Single message\"}]\n        result = chat_list_to_string(messages)\n        \n        assert result == \"user: Single message\"\n\n    def test_chat_list_to_string_with_empty_content(self):\n        \"\"\"Test chat_list_to_string with empty content.\"\"\"\n        messages = [\n            {\"role\": \"user\", \"content\": \"\"},\n            {\"role\": \"assistant\", \"content\": \"Response\"}\n        ]\n        \n        expected = \"user:\\nassistant: Response\"\n        result = chat_list_to_string(messages)\n        \n        assert result == expected\n\n    def test_chat_list_to_string_with_whitespace_content(self):\n        \"\"\"Test chat_list_to_string strips whitespace from content and role.\"\"\"\n        messages = [\n            {\"role\": \"  user  \", \"content\": \"  Hello world  \"},\n            {\"role\": \"assistant\", \"content\": \"  Response  \"}\n        ]\n        \n        expected = \"user: Hello world\\nassistant: Response\"\n        result = chat_list_to_string(messages)\n        \n        assert result == expected\n\n    def test_chat_list_to_string_with_multiline_content(self):\n        \"\"\"Test chat_list_to_string with multiline content.\"\"\"\n        messages = [\n            {\"role\": \"user\", \"content\": \"Line 1\\nLine 2\\nLine 3\"},\n            {\"role\": \"assistant\", \"content\": \"Multi\\nline\\nresponse\"}\n        ]\n        \n        expected = \"user: Line 1\\nLine 2\\nLine 3\\nassistant: Multi\\nline\\nresponse\"\n        result = chat_list_to_string(messages)\n        \n        assert result == expected\n\n    def test_chat_list_to_string_preserves_order(self):\n        \"\"\"Test that chat_list_to_string preserves message order.\"\"\"\n        messages = [\n            {\"role\": \"system\", \"content\": \"System message\"},\n            {\"role\": \"user\", \"content\": \"User message\"},\n            {\"role\": \"assistant\", \"content\": \"Assistant message\"},\n            {\"role\": \"user\", \"content\": \"Another user message\"}\n        ]\n        \n        result = chat_list_to_string(messages)\n        lines = result.split('\\n')\n        \n        assert lines[0] == \"system: System message\"\n        assert lines[1] == \"user: User message\"\n        assert lines[2] == \"assistant: Assistant message\"\n        assert lines[3] == \"user: Another user message\"\n\n\nclass TestChatStringToList:\n    def test_chat_string_to_list_basic(self):\n        \"\"\"Test chat_string_to_list with basic input.\"\"\"\n        input_string = \"user: Hello\\nassistant: Hi there!\\nuser: How are you?\"\n        \n        expected = [\n            {\"role\": \"user\", \"content\": \"Hello\"},\n            {\"role\": \"assistant\", \"content\": \"Hi there!\"},\n            {\"role\": \"user\", \"content\": \"How are you?\"}\n        ]\n        \n        result = chat_string_to_list(input_string)\n        assert result == expected\n\n    def test_chat_string_to_list_with_system_message(self):\n        \"\"\"Test chat_string_to_list with system message.\"\"\"\n        input_string = \"system: You are a helpful assistant\\nuser: Hello\\nassistant: Hi!\"\n        \n        expected = [\n            {\"role\": \"system\", \"content\": \"You are a helpful assistant\"},\n            {\"role\": \"user\", \"content\": \"Hello\"},\n            {\"role\": \"assistant\", \"content\": \"Hi!\"}\n        ]\n        \n        result = chat_string_to_list(input_string)\n        assert result == expected\n\n    def test_chat_string_to_list_case_insensitive(self):\n        \"\"\"Test chat_string_to_list is case insensitive for roles.\"\"\"\n        input_string = \"USER: Hello\\nASSISTANT: Hi\\nSYSTEM: System message\"\n        \n        expected = [\n            {\"role\": \"user\", \"content\": \"Hello\"},\n            {\"role\": \"assistant\", \"content\": \"Hi\"},\n            {\"role\": \"system\", \"content\": \"System message\"}\n        ]\n        \n        result = chat_string_to_list(input_string)\n        assert result == expected\n\n    def test_chat_string_to_list_multiline_content(self):\n        \"\"\"Test chat_string_to_list with multiline content.\"\"\"\n        input_string = \"user: Line 1\\nLine 2\\nLine 3\\nassistant: Response line 1\\nResponse line 2\"\n        \n        expected = [\n            {\"role\": \"user\", \"content\": \"Line 1 Line 2 Line 3\"},\n            {\"role\": \"assistant\", \"content\": \"Response line 1 Response line 2\"}\n        ]\n        \n        result = chat_string_to_list(input_string)\n        assert result == expected\n\n    def test_chat_string_to_list_empty_content(self):\n        \"\"\"Test chat_string_to_list with empty content after role.\"\"\"\n        input_string = \"user:\\nassistant: Response\"\n        \n        expected = [\n            {\"role\": \"user\", \"content\": \"\"},\n            {\"role\": \"assistant\", \"content\": \"Response\"}\n        ]\n        \n        result = chat_string_to_list(input_string)\n        assert result == expected\n\n    def test_chat_string_to_list_whitespace_handling(self):\n        \"\"\"Test chat_string_to_list handles whitespace correctly.\"\"\"\n        input_string = \"user:   Hello world   \\nassistant:   Response   \"\n        \n        expected = [\n            {\"role\": \"user\", \"content\": \"Hello world\"},\n            {\"role\": \"assistant\", \"content\": \"Response\"}\n        ]\n        \n        result = chat_string_to_list(input_string)\n        assert result == expected\n\n    def test_chat_string_to_list_empty_string(self):\n        \"\"\"Test chat_string_to_list with empty string.\"\"\"\n        result = chat_string_to_list(\"\")\n        assert result == []\n\n    def test_chat_string_to_list_no_roles(self):\n        \"\"\"Test chat_string_to_list with no role indicators.\"\"\"\n        input_string = \"Just some text\\nwithout roles\"\n        result = chat_string_to_list(input_string)\n        assert result == []\n\n    def test_chat_string_to_list_single_role(self):\n        \"\"\"Test chat_string_to_list with single role.\"\"\"\n        input_string = \"user: Single message\"\n        \n        expected = [{\"role\": \"user\", \"content\": \"Single message\"}]\n        result = chat_string_to_list(input_string)\n        assert result == expected\n\n\nclass TestChatListToINST:\n    def test_chat_list_to_INST_basic(self):\n        \"\"\"Test chat_list_to_INST with basic user message.\"\"\"\n        messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n        \n        result = chat_list_to_INST(messages)\n        \n        assert result.startswith(\"<s>\\\\n\\\\t[INST]\\\\n\")\n        assert \"Hello\" in result\n        assert \"[/INST]\" in result\n\n    def test_chat_list_to_INST_with_system_message(self):\n        \"\"\"Test chat_list_to_INST with system message.\"\"\"\n        messages = [\n            {\"role\": \"system\", \"content\": \"You are helpful\"},\n            {\"role\": \"user\", \"content\": \"Hello\"}\n        ]\n        \n        result = chat_list_to_INST(messages)\n        \n        assert \"<<SYS>>\" in result\n        assert \"You are helpful\" in result\n        assert \"<</SYS>>\" in result\n        assert \"Hello\" in result\n\n    def test_chat_list_to_INST_with_conversation(self):\n        \"\"\"Test chat_list_to_INST with full conversation.\"\"\"\n        messages = [\n            {\"role\": \"user\", \"content\": \"Hello\"},\n            {\"role\": \"assistant\", \"content\": \"Hi there!\"},\n            {\"role\": \"user\", \"content\": \"How are you?\"}\n        ]\n        \n        result = chat_list_to_INST(messages)\n        \n        assert \"Hello\" in result\n        assert \"Hi there!\" in result\n        assert \"How are you?\" in result\n        assert \"</s>\" in result  # End of turn marker\n\n    def test_chat_list_to_INST_removes_empty_assistant_placeholder(self):\n        \"\"\"Test that empty assistant message at end is removed.\"\"\"\n        messages = [\n            {\"role\": \"user\", \"content\": \"Hello\"},\n            {\"role\": \"assistant\", \"content\": \"\"}\n        ]\n        \n        result = chat_list_to_INST(messages)\n        \n        # Should not contain empty assistant content patterns\n        assert not result.endswith(\"\\\\n\\\\n</s>\\\\n<s>\\\\n\\\\t[INST]\\\\n\")\n\n    def test_chat_list_to_INST_preserves_non_empty_assistant(self):\n        \"\"\"Test that non-empty assistant messages are preserved.\"\"\"\n        messages = [\n            {\"role\": \"user\", \"content\": \"Hello\"},\n            {\"role\": \"assistant\", \"content\": \"Response\"}\n        ]\n        \n        result = chat_list_to_INST(messages)\n        \n        assert \"Response\" in result\n\n    def test_chat_list_to_INST_multiple_turns(self):\n        \"\"\"Test chat_list_to_INST with multiple conversation turns.\"\"\"\n        messages = [\n            {\"role\": \"user\", \"content\": \"First question\"},\n            {\"role\": \"assistant\", \"content\": \"First answer\"},\n            {\"role\": \"user\", \"content\": \"Second question\"},\n            {\"role\": \"assistant\", \"content\": \"Second answer\"}\n        ]\n        \n        result = chat_list_to_INST(messages)\n        \n        # Should have multiple turns\n        assert result.count(\"</s>\") >= 1\n        assert result.count(\"<s>\") >= 2\n        assert \"First question\" in result\n        assert \"First answer\" in result\n        assert \"Second question\" in result\n        assert \"Second answer\" in result\n\n\nclass TestINSTOutputToOutput:\n    def test_INST_output_to_output_basic(self):\n        \"\"\"Test INST_output_to_output extracts response correctly.\"\"\"\n        input_string = \"<s>\\\\n\\\\t[INST]\\\\n\\\\t\\\\tHello\\\\n\\\\t[/INST]\\\\n\\\\n\\\\tHi there!\"\n        \n        result = INST_output_to_output(input_string)\n        \n        assert result == \"Hi there!\"\n\n    def test_INST_output_to_output_multiple_inst_blocks(self):\n        \"\"\"Test INST_output_to_output finds the last INST block.\"\"\"\n        input_string = \"<s>\\\\n\\\\t[INST]\\\\n\\\\t\\\\tFirst\\\\n\\\\t[/INST]\\\\n\\\\n\\\\tFirst response</s><s>\\\\n\\\\t[INST]\\\\n\\\\t\\\\tSecond\\\\n\\\\t[/INST]\\\\n\\\\n\\\\tSecond response\"\n        \n        result = INST_output_to_output(input_string)\n        \n        assert result == \"Second response\"\n\n    def test_INST_output_to_output_no_inst_block(self):\n        \"\"\"Test INST_output_to_output when no [/INST] found.\"\"\"\n        input_string = \"Just some text without INST markers\"\n        \n        result = INST_output_to_output(input_string)\n        \n        # When rfind returns -1, the slice will be from beginning\n        # The function will return from position len('[/INST]\\\\n\\\\n\\\\t') - 1 = 11\n        assert result == input_string[11:]\n\n    def test_INST_output_to_output_empty_response(self):\n        \"\"\"Test INST_output_to_output with empty response.\"\"\"\n        input_string = \"<s>\\\\n\\\\t[INST]\\\\n\\\\t\\\\tHello\\\\n\\\\t[/INST]\\\\n\\\\n\\\\t\"\n        \n        result = INST_output_to_output(input_string)\n        \n        assert result == \"\"\n\n    def test_INST_output_to_output_multiline_response(self):\n        \"\"\"Test INST_output_to_output with multiline response.\"\"\"\n        input_string = \"<s>\\\\n\\\\t[INST]\\\\n\\\\t\\\\tHello\\\\n\\\\t[/INST]\\\\n\\\\n\\\\tLine 1\\\\nLine 2\\\\nLine 3\"\n        \n        result = INST_output_to_output(input_string)\n        \n        assert result == \"Line 1\\\\nLine 2\\\\nLine 3\"\n\n\nclass TestAssistantOutputToOutput:\n    def test_ASSISTANT_output_to_output_basic(self):\n        \"\"\"Test ASSISTANT_output_to_output extracts assistant response.\"\"\"\n        input_string = \"user: Hello\\\\nassistant: Hi there!\"\n        \n        result = ASSISTANT_output_to_output(input_string)\n        \n        assert result == \"Hi there!\"\n\n    def test_ASSISTANT_output_to_output_multiple_speakers(self):\n        \"\"\"Test ASSISTANT_output_to_output with multiple speakers.\"\"\"\n        input_string = \"user: First\\\\nassistant: Response 1\\\\nuser: Second\\\\nassistant: Final response\"\n        \n        result = ASSISTANT_output_to_output(input_string)\n        \n        assert result == \"Final response\"\n\n    def test_ASSISTANT_output_to_output_no_speakers(self):\n        \"\"\"Test ASSISTANT_output_to_output with no speaker patterns.\"\"\"\n        input_string = \"Just some text without speaker patterns\"\n        \n        result = ASSISTANT_output_to_output(input_string)\n        \n        assert result == \"Just some text without speaker patterns\"\n\n    def test_ASSISTANT_output_to_output_different_speaker_format(self):\n        \"\"\"Test ASSISTANT_output_to_output with different speaker formats.\"\"\"\n        input_string = \"User: Hello\\\\nBot: Hi\\\\nSystem: Working\\\\nAssistant: Final\"\n        \n        result = ASSISTANT_output_to_output(input_string)\n        \n        assert result == \"Final\"\n\n    def test_ASSISTANT_output_to_output_whitespace_handling(self):\n        \"\"\"Test ASSISTANT_output_to_output strips whitespace.\"\"\"\n        input_string = \"user: Hello\\\\nassistant:   Response with spaces   \"\n        \n        result = ASSISTANT_output_to_output(input_string)\n        \n        assert result == \"Response with spaces\"\n\n    def test_ASSISTANT_output_to_output_empty_response(self):\n        \"\"\"Test ASSISTANT_output_to_output with empty final response.\"\"\"\n        input_string = \"user: Hello\\\\nassistant:\"\n        \n        result = ASSISTANT_output_to_output(input_string)\n        \n        assert result == \"\"\n\n    def test_ASSISTANT_output_to_output_colon_in_content(self):\n        \"\"\"Test ASSISTANT_output_to_output when content contains colons.\"\"\"\n        input_string = \"user: What time is it?\\\\nassistant: It's 3:30 PM\"\n        \n        result = ASSISTANT_output_to_output(input_string)\n        \n        assert result == \"It's 3:30 PM\"\n\n\nclass TestPromptsIntegration:\n    def test_round_trip_conversion(self):\n        \"\"\"Test converting list to string and back to list.\"\"\"\n        original_messages = [\n            {\"role\": \"system\", \"content\": \"You are helpful\"},\n            {\"role\": \"user\", \"content\": \"Hello\"},\n            {\"role\": \"assistant\", \"content\": \"Hi there!\"}\n        ]\n        \n        # Convert to string\n        string_format = chat_list_to_string(original_messages)\n        \n        # Convert back to list\n        result_messages = chat_string_to_list(string_format)\n        \n        assert result_messages == original_messages\n\n    def test_empty_inputs_handling(self):\n        \"\"\"Test all functions handle empty inputs gracefully.\"\"\"\n        # Empty list\n        assert chat_list_to_string([]) == \"\"\n        assert chat_string_to_list(\"\") == []\n        \n        # List with empty message should not crash\n        empty_message = [{\"role\": \"user\", \"content\": \"\"}]\n        result = chat_list_to_INST(empty_message)\n        assert isinstance(result, str)\n\n    def test_special_characters_preservation(self):\n        \"\"\"Test that special characters are preserved through conversions.\"\"\"\n        messages = [\n            {\"role\": \"user\", \"content\": \"Special chars: !@#$%^&*()\"},\n            {\"role\": \"assistant\", \"content\": \"Unicode: \ud83d\ude80 \u00f1 \u00fc \u00f1\"}\n        ]\n        \n        string_format = chat_list_to_string(messages)\n        result_messages = chat_string_to_list(string_format)\n        \n        assert result_messages[0][\"content\"] == \"Special chars: !@#$%^&*()\"\n        assert result_messages[1][\"content\"] == \"Unicode: \ud83d\ude80 \u00f1 \u00fc \u00f1\"\n\n    def test_large_conversation_handling(self):\n        \"\"\"Test functions with large conversations.\"\"\"\n        large_conversation = []\n        for i in range(100):\n            large_conversation.append({\n                \"role\": \"user\" if i % 2 == 0 else \"assistant\",\n                \"content\": f\"Message {i}\"\n            })\n        \n        # Should not crash with large inputs\n        string_result = chat_list_to_string(large_conversation)\n        assert isinstance(string_result, str)\n        assert len(string_result) > 0\n        \n        inst_result = chat_list_to_INST(large_conversation)\n        assert isinstance(inst_result, str)\n        assert len(inst_result) > 0\n\n    def test_consistent_role_handling(self):\n        \"\"\"Test that all functions handle role variations consistently.\"\"\"\n        test_roles = [\"system\", \"user\", \"assistant\", \"SYSTEM\", \"USER\", \"ASSISTANT\"]\n        \n        for role in test_roles:\n            messages = [{\"role\": role, \"content\": \"Test message\"}]\n            \n            # Should not crash\n            try:\n                chat_list_to_string(messages)\n                chat_list_to_INST(messages)\n            except Exception as e:\n                pytest.fail(f\"Function crashed with role '{role}': {e}\")"
