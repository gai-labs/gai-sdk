                        "tool_use_id": "toolu_01NowfWAbDn6qw1SRsyZTJNc",
                        "content": "{\n  \"content\": \"\\\"\\\"\\\"\\nUnit tests for gai.lib.color module.\\nTests color formatting utilities and terminal color output.\\n\\\"\\\"\\\"\\nimport pytest\\nfrom unittest.mock import patch, call\\nimport io\\nimport sys\\n\\nfrom gai.lib.color import Color, yellow, green, red\\n\\n\\nclass TestColor:\\n    def test_color_initialization(self):\\n        \\\"\\\"\\\"Test Color class initialization.\\\"\\\"\\\"\\n        color = Color()\\n        assert color._format == []\\n\\n    def test_color_constants(self):\\n        \\\"\\\"\\\"Test that color constants are defined correctly.\\\"\\\"\\\"\\n        expected_colors = {\\n            'white': '\\\\033[97m',\\n            'red': '\\\\033[91m',\\n            'green': '\\\\033[92m',\\n            'blue': '\\\\033[94m',\\n            'yellow': '\\\\033[93m',\\n            'purple': '\\\\033[95m',\\n            'cyan': '\\\\033[96m'\\n        }\\n        assert Color.COLORS == expected_colors\\n\\n    def test_style_constants(self):\\n        \\\"\\\"\\\"Test that style constants are defined correctly.\\\"\\\"\\\"\\n        expected_styles = {\\n            'italic': '\\\\033[3m',\\n            'bold': '\\\\033[1m'\\n        }\\n        assert Color.STYLES == expected_styles\\n\\n    def test_reset_constant(self):\\n        \\\"\\\"\\\"Test that reset constant is defined correctly.\\\"\\\"\\\"\\n        assert Color.RESET == '\\\\033[0m'\\n\\n    def test_color_attribute_access(self):\\n        \\\"\\\"\\\"Test accessing color attributes.\\\"\\\"\\\"\\n        color = Color()\\n        \\n        # Test accessing a color\\n        result = color.red\\n        assert result is color  # Should return self for chaining\\n        assert '\\\\033[91m' in color._format\\n\\n    def test_style_attribute_access(self):\\n        \\\"\\\"\\\"Test accessing style attributes.\\\"\\\"\\\"\\n        color = Color()\\n        \\n        # Test accessing a style\\n        result = color.bold\\n        assert result is color  # Should return self for chaining\\n        assert '\\\\033[1m' in color._format\\n\\n    def test_invalid_attribute_access(self):\\n        \\\"\\\"\\\"Test accessing invalid attributes raises AttributeError.\\\"\\\"\\\"\\n        color = Color()\\n        \\n        with pytest.raises(AttributeError) as exc_info:\\n            color.invalid_color\\n        \\n        assert \\\"'Color' object has no attribute 'invalid_color'\\\" in str(exc_info.value)\\n\\n    def test_attribute_chaining(self):\\n        \\\"\\\"\\\"Test chaining multiple color and style attributes.\\\"\\\"\\\"\\n        color = Color()\\n        \\n        # Chain multiple attributes\\n        result = color.red.bold.italic\\n        assert result is color\\n        assert '\\\\033[91m' in color._format  # red\\n        assert '\\\\033[1m' in color._format   # bold\\n        assert '\\\\033[3m' in color._format   # italic\\n\\n    @patch('builtins.print')\\n    def test_color_call_default_params(self, mock_print):\\n        \\\"\\\"\\\"Test calling Color instance with default parameters.\\\"\\\"\\\"\\n        color = Color()\\n        color.red(\\\"Hello World\\\")\\n        \\n        expected_output = '\\\\033[91mHello World\\\\033[0m'\\n        mock_print.assert_called_once_with(expected_output, end=\\\"\\\\n\\\", flush=False)\\n\\n    @patch('builtins.print')\\n    def test_color_call_custom_params(self, mock_print):\\n        \\\"\\\"\\\"Test calling Color instance with custom parameters.\\\"\\\"\\\"\\n        color = Color()\\n        color.green(\\\"Test\\\", end=\\\"\\\", flush=True)\\n        \\n        expected_output = '\\\\033[92mTest\\\\033[0m'\\n        mock_print.assert_called_once_with(expected_output, end=\\\"\\\", flush=True)\\n\\n    @patch('builtins.print')\\n    def test_color_call_with_chaining(self, mock_print):\\n        \\\"\\\"\\\"Test calling Color instance with chained attributes.\\\"\\\"\\\"\\n        color = Color()\\n        color.blue.bold(\\\"Chained\\\")\\n        \\n        expected_output = '\\\\033[94m\\\\033[1mChained\\\\033[0m'\\n        mock_print.assert_called_once_with(expected_output, end=\\\"\\\\n\\\", flush=False)\\n\\n    def test_format_reset_after_call(self):\\n        \\\"\\\"\\\"Test that _format is reset after calling the Color instance.\\\"\\\"\\\"\\n        color = Color()\\n        color.red.bold\\n        \\n        # Check format is populated\\n        assert len(color._format) == 2\\n        \\n        # Call the instance\\n        with patch('builtins.print'):\\n            color(\\\"test\\\")\\n        \\n        # Check format is reset\\n        assert color._format == []\\n\\n    @patch('builtins.print')\\n    def test_multiple_calls_independent(self, mock_print):\\n        \\\"\\\"\\\"Test that multiple calls are independent.\\\"\\\"\\\"\\n        color = Color()\\n        \\n        # First call\\n        color.red(\\\"First\\\")\\n        expected_first = '\\\\033[91mFirst\\\\033[0m'\\n        \\n        # Second call with different color\\n        color.blue(\\\"Second\\\")\\n        expected_second = '\\\\033[94mSecond\\\\033[0m'\\n        \\n        calls = [\\n            call(expected_first, end=\\\"\\\\n\\\", flush=False),\\n            call(expected_second, end=\\\"\\\\n\\\", flush=False)\\n        ]\\n        mock_print.assert_has_calls(calls)\\n\\n    def test_all_colors_accessible(self):\\n        \\\"\\\"\\\"Test that all defined colors are accessible.\\\"\\\"\\\"\\n        color = Color()\\n        \\n        for color_name in Color.COLORS:\\n            # Should not raise AttributeError\\n            getattr(color, color_name)\\n            # Reset format for next test\\n            color._format = []\\n\\n    def test_all_styles_accessible(self):\\n        \\\"\\\"\\\"Test that all defined styles are accessible.\\\"\\\"\\\"\\n        color = Color()\\n        \\n        for style_name in Color.STYLES:\\n            # Should not raise AttributeError\\n            getattr(color, style_name)\\n            # Reset format for next test\\n            color._format = []\\n\\n\\nclass TestColorFunctions:\\n    @patch('builtins.print')\\n    def test_yellow_function(self, mock_print):\\n        \\\"\\\"\\\"Test yellow function.\\\"\\\"\\\"\\n        test_text = \\\"Yellow text\\\"\\n        yellow(test_text)\\n        \\n        expected_output = f\\\"\\\\033[33m{test_text}\\\\033[0m\\\"\\n        mock_print.assert_called_once_with(expected_output)\\n\\n    @patch('builtins.print')\\n    def test_green_function(self, mock_print):\\n        \\\"\\\"\\\"Test green function.\\\"\\\"\\\"\\n        test_text = \\\"Green text\\\"\\n        green(test_text)\\n        \\n        expected_output = f\\\"\\\\033[32m{test_text}\\\\033[0m\\\"\\n        mock_print.assert_called_once_with(expected_output)\\n\\n    @patch('builtins.print')\\n    def test_red_function(self, mock_print):\\n        \\\"\\\"\\\"Test red function.\\\"\\\"\\\"\\n        test_text = \\\"Red text\\\"\\n        red(test_text)\\n        \\n        expected_output = f\\\"\\\\033[31m{test_text}\\\\033[0m\\\"\\n        mock_print.assert_called_once_with(expected_output)\\n\\n    @patch('builtins.print')\\n    def test_color_functions_with_special_characters(self, mock_print):\\n        \\\"\\\"\\\"Test color functions with special characters.\\\"\\\"\\\"\\n        special_text = \\\"Special: !@#$%^&*()\\\"\\n        \\n        red(special_text)\\n        expected_output = f\\\"\\\\033[31m{special_text}\\\\033[0m\\\"\\n        mock_print.assert_called_with(expected_output)\\n\\n    @patch('builtins.print')\\n    def test_color_functions_with_empty_string(self, mock_print):\\n        \\\"\\\"\\\"Test color functions with empty string.\\\"\\\"\\\"\\n        empty_text = \\\"\\\"\\n        \\n        green(empty_text)\\n        expected_output = f\\\"\\\\033[32m{empty_text}\\\\033[0m\\\"\\n        mock_print.assert_called_with(expected_output)\\n\\n\\nclass TestColorIntegration:\\n    @patch('builtins.print')\\n    def test_color_class_vs_functions_consistency(self, mock_print):\\n        \\\"\\\"\\\"Test that Color class and standalone functions use consistent codes.\\\"\\\"\\\"\\n        text = \\\"Test text\\\"\\n        \\n        # The standalone functions use slightly different codes than the Color class\\n        # This is expected behavior based on the source code\\n        red(text)\\n        expected_standalone = f\\\"\\\\033[31m{text}\\\\033[0m\\\"\\n        \\n        color = Color()\\n        color.red(text)\\n        expected_class = f\\\"\\\\033[91m{text}\\\\033[0m\\\"\\n        \\n        calls = [\\n            call(expected_standalone),\\n            call(expected_class, end=\\\"\\\\n\\\", flush=False)\\n        ]\\n        mock_print.assert_has_calls(calls)\\n\\n    @patch('builtins.print')\\n    def test_complex_formatting_scenarios(self, mock_print):\\n        \\\"\\\"\\\"Test complex formatting scenarios.\\\"\\\"\\\"\\n        color = Color()\\n        \\n        # Test multiple chained attributes\\n        color.red.bold.italic(\\\"Complex formatting\\\")\\n        \\n        # Should include red color, bold style, and italic style\\n        expected = \\\"\\\\033[91m\\\\033[1m\\\\033[3mComplex formatting\\\\033[0m\\\"\\n        mock_print.assert_called_with(expected, end=\\\"\\\\n\\\", flush=False)\\n\\n    def test_format_attribute_order_preservation(self):\\n        \\\"\\\"\\\"Test that the order of chained attributes is preserved.\\\"\\\"\\\"\\n        color = Color()\\n        \\n        # Chain in specific order\\n        color.red.bold.italic.green\\n        \\n        # Check the order in _format\\n        expected_order = [\\n            Color.COLORS['red'],\\n            Color.STYLES['bold'], \\n            Color.STYLES['italic'],\\n            Color.COLORS['green']\\n        ]\\n        assert color._format == expected_order\"\n}"
