                        "type": "tool_result",
                        "tool_use_id": "toolu_01FsyCv1M8SYwGQhcQyYGiUd",
                        "content": "{\n  \"content\": \"\\\"\\\"\\\"\\nUnit tests for gai.lib.strings module.\\nTests string utility functions.\\n\\\"\\\"\\\"\\nimport pytest\\n\\nfrom gai.lib.strings import clean_string\\n\\n\\nclass TestCleanString:\\n    def test_clean_string_with_none(self):\\n        \\\"\\\"\\\"Test clean_string with None input.\\\"\\\"\\\"\\n        result = clean_string(None)\\n        assert result == ''\\n        assert isinstance(result, str)\\n\\n    def test_clean_string_with_empty_string(self):\\n        \\\"\\\"\\\"Test clean_string with empty string.\\\"\\\"\\\"\\n        result = clean_string('')\\n        assert result == ''\\n\\n    def test_clean_string_with_single_space(self):\\n        \\\"\\\"\\\"Test clean_string with single space.\\\"\\\"\\\"\\n        result = clean_string(' ')\\n        assert result == ' '\\n\\n    def test_clean_string_with_multiple_spaces(self):\\n        \\\"\\\"\\\"Test clean_string with multiple consecutive spaces.\\\"\\\"\\\"\\n        input_str = 'hello    world'\\n        result = clean_string(input_str)\\n        assert result == 'hello world'\\n\\n    def test_clean_string_with_tabs(self):\\n        \\\"\\\"\\\"Test clean_string with tabs.\\\"\\\"\\\"\\n        input_str = 'hello\\\\tworld'\\n        result = clean_string(input_str)\\n        assert result == 'hello world'\\n\\n    def test_clean_string_with_newlines(self):\\n        \\\"\\\"\\\"Test clean_string with newlines.\\\"\\\"\\\"\\n        input_str = 'hello\\\\nworld'\\n        result = clean_string(input_str)\\n        assert result == 'hello world'\\n\\n    def test_clean_string_with_carriage_returns(self):\\n        \\\"\\\"\\\"Test clean_string with carriage returns.\\\"\\\"\\\"\\n        input_str = 'hello\\\\rworld'\\n        result = clean_string(input_str)\\n        assert result == 'hello world'\\n\\n    def test_clean_string_with_mixed_whitespace(self):\\n        \\\"\\\"\\\"Test clean_string with mixed whitespace characters.\\\"\\\"\\\"\\n        input_str = 'hello\\\\t\\\\n\\\\r world\\\\n\\\\n\\\\ttest'\\n        result = clean_string(input_str)\\n        assert result == 'hello world test'\\n\\n    def test_clean_string_with_leading_whitespace(self):\\n        \\\"\\\"\\\"Test clean_string with leading whitespace.\\\"\\\"\\\"\\n        input_str = '   hello world'\\n        result = clean_string(input_str)\\n        assert result == ' hello world'\\n\\n    def test_clean_string_with_trailing_whitespace(self):\\n        \\\"\\\"\\\"Test clean_string with trailing whitespace.\\\"\\\"\\\"\\n        input_str = 'hello world   '\\n        result = clean_string(input_str)\\n        assert result == 'hello world '\\n\\n    def test_clean_string_with_leading_and_trailing_whitespace(self):\\n        \\\"\\\"\\\"Test clean_string with both leading and trailing whitespace.\\\"\\\"\\\"\\n        input_str = '   hello world   '\\n        result = clean_string(input_str)\\n        assert result == ' hello world '\\n\\n    def test_clean_string_with_no_whitespace(self):\\n        \\\"\\\"\\\"Test clean_string with string containing no whitespace.\\\"\\\"\\\"\\n        input_str = 'helloworld'\\n        result = clean_string(input_str)\\n        assert result == 'helloworld'\\n\\n    def test_clean_string_with_only_whitespace(self):\\n        \\\"\\\"\\\"Test clean_string with string containing only whitespace.\\\"\\\"\\\"\\n        input_str = '   \\\\t\\\\n\\\\r   '\\n        result = clean_string(input_str)\\n        assert result == ' '\\n\\n    def test_clean_string_preserves_single_spaces(self):\\n        \\\"\\\"\\\"Test that clean_string preserves single spaces between words.\\\"\\\"\\\"\\n        input_str = 'hello world test'\\n        result = clean_string(input_str)\\n        assert result == 'hello world test'\\n\\n    def test_clean_string_with_unicode_whitespace(self):\\n        \\\"\\\"\\\"Test clean_string with Unicode whitespace characters.\\\"\\\"\\\"\\n        # Using actual Unicode whitespace characters\\n        input_str = 'hello\\\\u00A0\\\\u2000world'  # non-breaking space and en quad\\n        result = clean_string(input_str)\\n        # Note: The current implementation only handles \\\\s+ which includes most Unicode whitespace\\n        assert 'hello' in result\\n        assert 'world' in result\\n        assert result.count(' ') <= 1  # Should be collapsed to single space or handled\\n\\n    def test_clean_string_with_special_characters(self):\\n        \\\"\\\"\\\"Test clean_string preserves special characters that aren't whitespace.\\\"\\\"\\\"\\n        input_str = 'hello!@#$%^&*()world'\\n        result = clean_string(input_str)\\n        assert result == 'hello!@#$%^&*()world'\\n\\n    def test_clean_string_with_numbers(self):\\n        \\\"\\\"\\\"Test clean_string with numeric characters.\\\"\\\"\\\"\\n        input_str = 'hello123   456world'\\n        result = clean_string(input_str)\\n        assert result == 'hello123 456world'\\n\\n    def test_clean_string_with_multiple_words_and_mixed_spacing(self):\\n        \\\"\\\"\\\"Test clean_string with multiple words and various spacing issues.\\\"\\\"\\\"\\n        input_str = 'The   quick\\\\t\\\\tbrown\\\\n\\\\nfox    jumps'\\n        result = clean_string(input_str)\\n        assert result == 'The quick brown fox jumps'\\n\\n    def test_clean_string_idempotent(self):\\n        \\\"\\\"\\\"Test that applying clean_string multiple times gives same result.\\\"\\\"\\\"\\n        input_str = 'hello   \\\\t\\\\n  world'\\n        first_clean = clean_string(input_str)\\n        second_clean = clean_string(first_clean)\\n        assert first_clean == second_clean\\n\\n    def test_clean_string_with_empty_after_cleaning(self):\\n        \\\"\\\"\\\"Test clean_string with string that becomes empty after cleaning.\\\"\\\"\\\"\\n        # This shouldn't happen with current implementation since it preserves at least one space\\n        input_str = '\\\\t\\\\n\\\\r'\\n        result = clean_string(input_str)\\n        assert result == ' '  # Should become a single space\\n\\n    def test_clean_string_return_type(self):\\n        \\\"\\\"\\\"Test that clean_string always returns a string.\\\"\\\"\\\"\\n        test_cases = [None, '', ' ', 'hello world', '   multiple   spaces   ']\\n        \\n        for test_case in test_cases:\\n            result = clean_string(test_case)\\n            assert isinstance(result, str)\\n\\n\\nclass TestCleanStringEdgeCases:\\n    def test_clean_string_with_very_long_string(self):\\n        \\\"\\\"\\\"Test clean_string with a very long string.\\\"\\\"\\\"\\n        # Create a string with many spaces\\n        input_str = 'word' + '   ' * 1000 + 'another'\\n        result = clean_string(input_str)\\n        assert result == 'word another'\\n\\n    def test_clean_string_with_alternating_spaces(self):\\n        \\\"\\\"\\\"Test clean_string with alternating single and multiple spaces.\\\"\\\"\\\"\\n        input_str = 'a  b   c    d     e'\\n        result = clean_string(input_str)\\n        assert result == 'a b c d e'\\n\\n    def test_clean_string_performance_large_input(self):\\n        \\\"\\\"\\\"Test clean_string performance with large input (basic check).\\\"\\\"\\\"\\n        # Create a large string with mixed whitespace\\n        words = ['word'] * 100\\n        input_str = '\\\\t\\\\n  '.join(words)\\n        \\n        # Should complete without error\\n        result = clean_string(input_str)\\n        assert isinstance(result, str)\\n        assert 'word' in result\\n\\n    def test_clean_string_regex_special_cases(self):\\n        \\\"\\\"\\\"Test clean_string handles edge cases that might affect regex.\\\"\\\"\\\"\\n        # Test with string that might confuse regex\\n        input_str = 'hello\\\\\\\\s+world'  # Contains literal \\\\s+ \\n        result = clean_string(input_str)\\n        # Should not be affected by regex pattern in the string\\n        assert 'hello\\\\\\\\s+world' in result\\n\\n\\nclass TestCleanStringIntegration:\\n    def test_clean_string_typical_use_cases(self):\\n        \\\"\\\"\\\"Test clean_string with typical real-world use cases.\\\"\\\"\\\"\\n        test_cases = [\\n            # (input, expected_output)\\n            ('Hello   World!', 'Hello World!'),\\n            ('\\\\tTabbed\\\\tcontent\\\\t', ' Tabbed content '),\\n            ('Line1\\\\nLine2\\\\nLine3', 'Line1 Line2 Line3'),\\n            ('Mixed\\\\t  \\\\n  content', 'Mixed content'),\\n            ('Already clean', 'Already clean'),\\n        ]\\n        \\n        for input_str, expected in test_cases:\\n            result = clean_string(input_str)\\n            assert result == expected\\n\\n    def test_clean_string_with_formatted_text(self):\\n        \\\"\\\"\\\"Test clean_string with formatted text scenarios.\\\"\\\"\\\"\\n        # Simulate text that might come from formatted sources\\n        input_str = '''This is a paragraph\\n        with multiple lines\\n        and    inconsistent    spacing.'''\\n        \\n        result = clean_string(input_str)\\n        \\n        # Should have normalized spacing\\n        assert 'This is a paragraph with multiple lines and inconsistent spacing.' in result\\n        # Should not have multiple consecutive spaces\\n        assert '  ' not in result\"\n}"
