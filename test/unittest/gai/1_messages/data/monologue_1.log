                    {
                        "type": "tool_result",
                        "tool_use_id": "toolu_01XZgUetLrNrSfw4oSf9ULNo",
                        "content": "{\n  \"content\": \"\\\"\\\"\\\"\\nUnit tests for gai.lib.config.config_base module.\\nTests the base configuration classes and models.\\n\\\"\\\"\\\"\\nimport pytest\\nfrom unittest.mock import patch, mock_open\\nfrom pydantic import ValidationError\\n\\nfrom gai.lib.config.config_base import ModuleConfig\\n\\n\\nclass TestModuleConfig:\\n    def test_module_config_creation_with_alias(self):\\n        \\\"\\\"\\\"Test ModuleConfig creation using 'class' alias.\\\"\\\"\\\"\\n        config_data = {\\n            \\\"name\\\": \\\"test_module\\\",\\n            \\\"class\\\": \\\"TestClass\\\"\\n        }\\n        \\n        config = ModuleConfig(**config_data)\\n        \\n        assert config.name == \\\"test_module\\\"\\n        assert config.class_ == \\\"TestClass\\\"\\n\\n    def test_module_config_creation_with_field_name(self):\\n        \\\"\\\"\\\"Test ModuleConfig creation using 'class_' field name (should fail).\\\"\\\"\\\"\\n        config_data = {\\n            \\\"name\\\": \\\"test_module\\\",\\n            \\\"class_\\\": \\\"TestClass\\\"\\n        }\\n        \\n        # This should fail because class_ is not the expected input field\\n        with pytest.raises(ValidationError):\\n            ModuleConfig(**config_data)\\n\\n    def test_module_config_access_via_alias(self):\\n        \\\"\\\"\\\"Test accessing ModuleConfig field via alias.\\\"\\\"\\\"\\n        config = ModuleConfig(**{\\\"name\\\": \\\"test\\\", \\\"class\\\": \\\"TestClass\\\"})\\n        \\n        # Both ways should work due to allow_population_by_name\\n        assert hasattr(config, 'class_')\\n        assert config.class_ == \\\"TestClass\\\"\\n\\n    def test_module_config_required_fields(self):\\n        \\\"\\\"\\\"Test that required fields are enforced.\\\"\\\"\\\"\\n        # Missing 'name' field\\n        with pytest.raises(ValidationError) as exc_info:\\n            ModuleConfig(**{\\\"class\\\": \\\"TestClass\\\"})\\n        \\n        assert \\\"name\\\" in str(exc_info.value)\\n        \\n        # Missing 'class' field\\n        with pytest.raises(ValidationError) as exc_info:\\n            ModuleConfig(name=\\\"test\\\")\\n        \\n        assert \\\"class\\\" in str(exc_info.value) or \\\"class_\\\" in str(exc_info.value)\\n\\n    def test_module_config_model_dump(self):\\n        \\\"\\\"\\\"Test ModuleConfig model serialization.\\\"\\\"\\\"\\n        config = ModuleConfig(**{\\\"name\\\": \\\"test_module\\\", \\\"class\\\": \\\"TestClass\\\"})\\n        \\n        dumped = config.model_dump()\\n        \\n        assert dumped[\\\"name\\\"] == \\\"test_module\\\"\\n        assert dumped[\\\"class_\\\"] == \\\"TestClass\\\"\\n\\n    def test_module_config_model_dump_by_alias(self):\\n        \\\"\\\"\\\"Test ModuleConfig model serialization with alias.\\\"\\\"\\\"\\n        config = ModuleConfig(**{\\\"name\\\": \\\"test_module\\\", \\\"class\\\": \\\"TestClass\\\"})\\n        \\n        dumped = config.model_dump(by_alias=True)\\n        \\n        assert dumped[\\\"name\\\"] == \\\"test_module\\\"\\n        assert dumped[\\\"class\\\"] == \\\"TestClass\\\"\\n\\n    def test_module_config_json_serialization(self):\\n        \\\"\\\"\\\"Test ModuleConfig JSON serialization.\\\"\\\"\\\"\\n        config = ModuleConfig(**{\\\"name\\\": \\\"test_module\\\", \\\"class\\\": \\\"TestClass\\\"})\\n        \\n        json_str = config.model_dump_json()\\n        \\n        assert \\\"test_module\\\" in json_str\\n        assert \\\"TestClass\\\" in json_str\\n\\n    def test_module_config_validation_string_types(self):\\n        \\\"\\\"\\\"Test that ModuleConfig validates string types.\\\"\\\"\\\"\\n        # Non-string name\\n        with pytest.raises(ValidationError):\\n            ModuleConfig(**{\\\"name\\\": 123, \\\"class\\\": \\\"TestClass\\\"})\\n        \\n        # Non-string class\\n        with pytest.raises(ValidationError):\\n            ModuleConfig(**{\\\"name\\\": \\\"test\\\", \\\"class\\\": 123})\\n\\n    def test_module_config_empty_strings(self):\\n        \\\"\\\"\\\"Test ModuleConfig with empty strings.\\\"\\\"\\\"\\n        config = ModuleConfig(**{\\\"name\\\": \\\"\\\", \\\"class\\\": \\\"\\\"})\\n        \\n        assert config.name == \\\"\\\"\\n        assert config.class_ == \\\"\\\"\\n\\n    def test_module_config_unicode_strings(self):\\n        \\\"\\\"\\\"Test ModuleConfig with Unicode strings.\\\"\\\"\\\"\\n        config = ModuleConfig(**{\\\"name\\\": \\\"\u6d4b\u8bd5\u6a21\u5757\\\", \\\"class\\\": \\\"TestClass\u6d4b\u8bd5\\\"})\\n        \\n        assert config.name == \\\"\u6d4b\u8bd5\u6a21\u5757\\\"\\n        assert config.class_ == \\\"TestClass\u6d4b\u8bd5\\\"\\n\\n    def test_module_config_extra_fields_not_allowed(self):\\n        \\\"\\\"\\\"Test that extra fields are ignored or rejected based on model config.\\\"\\\"\\\"\\n        # Based on the actual ModuleConfig implementation, test the actual behavior\\n        # If extra fields are allowed, this should work; if not, it should raise ValidationError\\n        try:\\n            config = ModuleConfig(**{\\\"name\\\": \\\"test\\\", \\\"class\\\": \\\"TestClass\\\", \\\"extra_field\\\": \\\"value\\\"})\\n            # If we get here, extra fields are allowed - test they don't appear in the model\\n            assert not hasattr(config, \\\"extra_field\\\")\\n        except ValidationError:\\n            # This is also acceptable behavior - extra fields are rejected\\n            pass\\n\\n    def test_module_config_copy(self):\\n        \\\"\\\"\\\"Test ModuleConfig copying.\\\"\\\"\\\"\\n        original = ModuleConfig(**{\\\"name\\\": \\\"test\\\", \\\"class\\\": \\\"TestClass\\\"})\\n        copied = original.model_copy()\\n        \\n        assert copied.name == original.name\\n        assert copied.class_ == original.class_\\n        assert copied is not original\\n\\n    def test_module_config_copy_with_update(self):\\n        \\\"\\\"\\\"Test ModuleConfig copying with updates.\\\"\\\"\\\"\\n        original = ModuleConfig(**{\\\"name\\\": \\\"test\\\", \\\"class\\\": \\\"TestClass\\\"})\\n        updated = original.model_copy(update={\\\"name\\\": \\\"updated_test\\\"})\\n        \\n        assert updated.name == \\\"updated_test\\\"\\n        assert updated.class_ == \\\"TestClass\\\"\\n        assert original.name == \\\"test\\\"  # Original unchanged\\n\\n    def test_module_config_equality(self):\\n        \\\"\\\"\\\"Test ModuleConfig equality comparison.\\\"\\\"\\\"\\n        config1 = ModuleConfig(**{\\\"name\\\": \\\"test\\\", \\\"class\\\": \\\"TestClass\\\"})\\n        config2 = ModuleConfig(**{\\\"name\\\": \\\"test\\\", \\\"class\\\": \\\"TestClass\\\"})\\n        config3 = ModuleConfig(**{\\\"name\\\": \\\"different\\\", \\\"class\\\": \\\"TestClass\\\"})\\n        \\n        assert config1 == config2\\n        assert config1 != config3\\n\\n    def test_module_config_hash(self):\\n        \\\"\\\"\\\"Test ModuleConfig hashing behavior.\\\"\\\"\\\"\\n        config1 = ModuleConfig(**{\\\"name\\\": \\\"test\\\", \\\"class\\\": \\\"TestClass\\\"})\\n        config2 = ModuleConfig(**{\\\"name\\\": \\\"test\\\", \\\"class\\\": \\\"TestClass\\\"})\\n        \\n        # Test if ModuleConfig is hashable\\n        try:\\n            hash1 = hash(config1)\\n            hash2 = hash(config2)\\n            # If hashable, equal configs should have same hash\\n            assert hash1 == hash2\\n        except TypeError:\\n            # If not hashable, that's also fine - just document the behavior\\n            assert not hasattr(config1, \\\"__hash__\\\") or config1.__hash__ is None\\n\\n    def test_module_config_repr(self):\\n        \\\"\\\"\\\"Test ModuleConfig string representation.\\\"\\\"\\\"\\n        config = ModuleConfig(**{\\\"name\\\": \\\"test\\\", \\\"class\\\": \\\"TestClass\\\"})\\n        repr_str = repr(config)\\n        \\n        assert \\\"ModuleConfig\\\" in repr_str\\n        assert \\\"test\\\" in repr_str\\n        assert \\\"TestClass\\\" in repr_str\\n\\n\\nclass TestModuleConfigIntegration:\\n    def test_module_config_in_dict(self):\\n        \\\"\\\"\\\"Test using ModuleConfig as dictionary values.\\\"\\\"\\\"\\n        config = ModuleConfig(**{\\\"name\\\": \\\"test\\\", \\\"class\\\": \\\"TestClass\\\"})\\n        config_dict = {\\\"module\\\": config}\\n        \\n        assert config_dict[\\\"module\\\"].name == \\\"test\\\"\\n        assert config_dict[\\\"module\\\"].class_ == \\\"TestClass\\\"\\n\\n    def test_module_config_list(self):\\n        \\\"\\\"\\\"Test ModuleConfig in lists.\\\"\\\"\\\"\\n        configs = [\\n            ModuleConfig(**{\\\"name\\\": \\\"test1\\\", \\\"class\\\": \\\"Class1\\\"}),\\n            ModuleConfig(**{\\\"name\\\": \\\"test2\\\", \\\"class\\\": \\\"Class2\\\"})\\n        ]\\n        \\n        assert len(configs) == 2\\n        assert configs[0].name == \\\"test1\\\"\\n        assert configs[1].name == \\\"test2\\\"\\n\\n    def test_module_config_from_different_sources(self):\\n        \\\"\\\"\\\"Test creating ModuleConfig from different data sources.\\\"\\\"\\\"\\n        # From dict with alias\\n        from_dict = ModuleConfig(**{\\\"name\\\": \\\"test\\\", \\\"class\\\": \\\"TestClass\\\"})\\n        \\n        # From dict with underscore (should fail)\\n        with pytest.raises(ValidationError):\\n            ModuleConfig(**{\\\"name\\\": \\\"test\\\", \\\"class_\\\": \\\"TestClass\\\"})\\n        \\n        assert from_dict.name == \\\"test\\\"\\n        assert from_dict.class_ == \\\"TestClass\\\"\\n\\n    def test_module_config_field_access_patterns(self):\\n        \\\"\\\"\\\"Test different ways to access ModuleConfig fields.\\\"\\\"\\\"\\n        config = ModuleConfig(**{\\\"name\\\": \\\"test\\\", \\\"class\\\": \\\"TestClass\\\"})\\n        \\n        # Direct attribute access\\n        assert config.name == \\\"test\\\"\\n        assert config.class_ == \\\"TestClass\\\"\\n        \\n        # Via getattr\\n        assert getattr(config, \\\"name\\\") == \\\"test\\\"\\n        assert getattr(config, \\\"class_\\\") == \\\"TestClass\\\"\\n\\n    def test_module_config_validation_edge_cases(self):\\n        \\\"\\\"\\\"Test ModuleConfig validation with edge cases.\\\"\\\"\\\"\\n        # Very long strings\\n        long_name = \\\"a\\\" * 1000\\n        long_class = \\\"b\\\" * 1000\\n        \\n        config = ModuleConfig(**{\\\"name\\\": long_name, \\\"class\\\": long_class})\\n        assert len(config.name) == 1000\\n        assert len(config.class_) == 1000\\n        \\n        # Strings with special characters\\n        special_config = ModuleConfig(**{\\n            \\\"name\\\": \\\"test-name_123\\\",\\n            \\\"class\\\": \\\"package.module.ClassName\\\"\\n        })\\n        assert special_config.name == \\\"test-name_123\\\"\\n        assert special_config.class_ == \\\"package.module.ClassName\\\"\\n\\n    def test_module_config_alias_behavior(self):\\n        \\\"\\\"\\\"Test the specific alias behavior of ModuleConfig.\\\"\\\"\\\"\\n        # Create with alias\\n        config = ModuleConfig(**{\\\"name\\\": \\\"test\\\", \\\"class\\\": \\\"TestClass\\\"})\\n        \\n        # Check internal storage uses class_\\n        assert hasattr(config, \\\"class_\\\")\\n        assert config.class_ == \\\"TestClass\\\"\\n        \\n        # Dump with alias should use \\\"class\\\"\\n        dumped_with_alias = config.model_dump(by_alias=True)\\n        assert \\\"class\\\" in dumped_with_alias\\n        assert \\\"class_\\\" not in dumped_with_alias\\n        assert dumped_with_alias[\\\"class\\\"] == \\\"TestClass\\\"\\n        \\n        # Dump without alias should use \\\"class_\\\"\\n        dumped_without_alias = config.model_dump(by_alias=False)\\n        assert \\\"class_\\\" in dumped_without_alias\\n        assert \\\"class\\\" not in dumped_without_alias\\n        assert dumped_without_alias[\\\"class_\\\"] == \\\"TestClass\\\"\"\n}"
