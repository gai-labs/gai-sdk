                            "path": "/workspace/tests/gai-lib/test_logging.py",
                            "content": "\"\"\"\nUnit tests for gai.lib.logging module.\nTests the custom logger creation and configuration with Rich formatting.\n\"\"\"\nimport pytest\nimport logging\nimport os\nfrom unittest.mock import patch, Mock, MagicMock\n\nfrom gai.lib.logging import getLogger\n\n\nclass TestGetLogger:\n    def test_get_logger_creates_logger(self):\n        \"\"\"Test that getLogger creates a logger with the given name.\"\"\"\n        logger_name = \"test.module\"\n        logger = getLogger(logger_name)\n        \n        assert isinstance(logger, logging.Logger)\n        assert logger.name == logger_name\n\n    def test_get_logger_clears_existing_handlers(self):\n        \"\"\"Test that getLogger removes existing handlers from logger.\"\"\"\n        logger_name = \"test.clear.handlers\"\n        \n        # Create logger with existing handler\n        existing_logger = logging.getLogger(logger_name)\n        existing_handler = logging.StreamHandler()\n        existing_logger.addHandler(existing_handler)\n        \n        # Verify handler exists\n        assert len(existing_logger.handlers) == 1\n        \n        # Call getLogger - should clear handlers\n        new_logger = getLogger(logger_name)\n        \n        # Should be the same logger object but with cleared handlers\n        assert new_logger is existing_logger\n        assert len(new_logger.handlers) == 1  # Should have one RichHandler now\n\n    @patch.dict(os.environ, {\"LOG_LEVEL\": \"INFO\"})\n    def test_get_logger_sets_log_level_from_env(self):\n        \"\"\"Test that getLogger sets log level from LOG_LEVEL environment variable.\"\"\"\n        logger = getLogger(\"test.log.level\")\n        \n        assert logger.level == logging.INFO\n\n    @patch.dict(os.environ, {\"LOG_LEVEL\": \"DEBUG\"})\n    def test_get_logger_sets_debug_level(self):\n        \"\"\"Test that getLogger can set DEBUG level.\"\"\"\n        logger = getLogger(\"test.debug.level\")\n        \n        assert logger.level == logging.DEBUG\n\n    @patch.dict(os.environ, {\"LOG_LEVEL\": \"ERROR\"})\n    def test_get_logger_sets_error_level(self):\n        \"\"\"Test that getLogger can set ERROR level.\"\"\"\n        logger = getLogger(\"test.error.level\")\n        \n        assert logger.level == logging.ERROR\n\n    @patch.dict(os.environ, {}, clear=True)\n    def test_get_logger_default_log_level(self):\n        \"\"\"Test that getLogger uses WARNING as default when LOG_LEVEL not set.\"\"\"\n        logger = getLogger(\"test.default.level\")\n        \n        assert logger.level == logging.WARNING\n\n    def test_get_logger_has_rich_handler(self):\n        \"\"\"Test that getLogger creates logger with RichHandler.\"\"\"\n        logger = getLogger(\"test.rich.handler\")\n        \n        assert len(logger.handlers) == 1\n        # The handler should be our custom LevelAwareRichHandler\n        handler = logger.handlers[0]\n        assert hasattr(handler, 'render_message')  # RichHandler method\n        assert hasattr(handler, 'console')  # RichHandler attribute\n\n    def test_get_logger_rich_handler_configuration(self):\n        \"\"\"Test that RichHandler is configured correctly.\"\"\"\n        logger = getLogger(\"test.rich.config\")\n        \n        handler = logger.handlers[0]\n        \n        # Check that the handler has the expected configuration\n        # Note: We can't directly access all private attributes, but we can test behavior\n        assert handler.formatter is not None\n        assert handler.formatter._fmt == \"%(message)s\"\n\n    def test_get_logger_multiple_calls_same_name(self):\n        \"\"\"Test that multiple calls with same name return same logger.\"\"\"\n        logger_name = \"test.same.name\"\n        \n        logger1 = getLogger(logger_name)\n        logger2 = getLogger(logger_name)\n        \n        # Should be the same logger object\n        assert logger1 is logger2\n        \n        # Should still have only one handler (not accumulating)\n        assert len(logger1.handlers) == 1\n        assert len(logger2.handlers) == 1\n\n    def test_get_logger_different_names(self):\n        \"\"\"Test that different names create different loggers.\"\"\"\n        logger1 = getLogger(\"test.name1\")\n        logger2 = getLogger(\"test.name2\")\n        \n        assert logger1 is not logger2\n        assert logger1.name != logger2.name\n\n    @patch('gai.lib.logging.Console')\n    def test_get_logger_creates_custom_console(self, mock_console_class):\n        \"\"\"Test that getLogger creates console with custom theme.\"\"\"\n        mock_console = Mock()\n        mock_console_class.return_value = mock_console\n        \n        getLogger(\"test.console\")\n        \n        # Should create console with theme and color_system\n        mock_console_class.assert_called_once()\n        args, kwargs = mock_console_class.call_args\n        \n        assert 'theme' in kwargs\n        assert 'color_system' in kwargs\n        assert kwargs['color_system'] == 'truecolor'\n\n    def test_get_logger_custom_theme_colors(self):\n        \"\"\"Test that custom theme includes expected color definitions.\"\"\"\n        # This is more of an integration test to ensure the theme is properly defined\n        logger = getLogger(\"test.theme\")\n        \n        # The logger should be created without errors\n        assert logger is not None\n        assert len(logger.handlers) == 1\n\n    @patch('gai.lib.logging.LevelAwareRichHandler')\n    def test_level_aware_rich_handler_called(self, mock_handler_class):\n        \"\"\"Test that our custom LevelAwareRichHandler is used.\"\"\"\n        mock_handler = Mock()\n        mock_handler_class.return_value = mock_handler\n        \n        getLogger(\"test.custom.handler\")\n        \n        # Should create our custom handler\n        mock_handler_class.assert_called_once()\n        \n        # Should set formatter on the handler\n        mock_handler.setFormatter.assert_called_once()\n\n    def test_get_logger_logging_functionality(self):\n        \"\"\"Test that the logger can actually log messages.\"\"\"\n        logger_name = \"test.logging.func\"\n        logger = getLogger(logger_name)\n        \n        # Should be able to call logging methods without error\n        try:\n            logger.debug(\"Debug message\")\n            logger.info(\"Info message\")\n            logger.warning(\"Warning message\")\n            logger.error(\"Error message\")\n            logger.critical(\"Critical message\")\n        except Exception as e:\n            pytest.fail(f\"Logger should handle all log levels without error: {e}\")\n\n    @patch.dict(os.environ, {\"LOG_LEVEL\": \"INVALID\"})\n    def test_get_logger_with_invalid_log_level(self):\n        \"\"\"Test getLogger behavior with invalid LOG_LEVEL.\"\"\"\n        # This should not crash, but the exact behavior depends on logging module\n        # The logging module should handle invalid levels gracefully\n        logger = getLogger(\"test.invalid.level\")\n        \n        # Logger should still be created\n        assert logger is not None\n        assert len(logger.handlers) == 1\n\n\nclass TestLoggerIntegration:\n    def test_logger_hierarchy_respected(self):\n        \"\"\"Test that logger hierarchy is respected.\"\"\"\n        parent_logger = getLogger(\"parent\")\n        child_logger = getLogger(\"parent.child\")\n        \n        # Child should be related to parent\n        assert child_logger.parent.name == \"parent\" or child_logger.name.startswith(\"parent.\")\n\n    @patch.dict(os.environ, {\"LOG_LEVEL\": \"DEBUG\"})\n    def test_multiple_loggers_same_config(self):\n        \"\"\"Test that multiple loggers get the same configuration.\"\"\"\n        logger1 = getLogger(\"test.multi1\")\n        logger2 = getLogger(\"test.multi2\")\n        \n        # Both should have same log level\n        assert logger1.level == logger2.level == logging.DEBUG\n        \n        # Both should have handlers\n        assert len(logger1.handlers) == 1\n        assert len(logger2.handlers) == 1\n\n    def test_logger_memory_management(self):\n        \"\"\"Test that loggers don't accumulate handlers over time.\"\"\"\n        logger_name = \"test.memory\"\n        \n        # Create logger multiple times\n        for i in range(5):\n            logger = getLogger(logger_name)\n            # Should always have exactly one handler\n            assert len(logger.handlers) == 1\n\n    def test_logger_thread_safety(self):\n        \"\"\"Basic test for thread safety concerns.\"\"\"\n        import threading\n        \n        results = []\n        \n        def create_logger(name_suffix):\n            logger = getLogger(f\"test.thread.{name_suffix}\")\n            results.append(len(logger.handlers))\n        \n        threads = []\n        for i in range(10):\n            thread = threading.Thread(target=create_logger, args=(i,))\n            threads.append(thread)\n            thread.start()\n        \n        for thread in threads:\n            thread.join()\n        \n        # All loggers should have exactly one handler\n        assert all(count == 1 for count in results)\n\n\nclass TestLevelAwareRichHandler:\n    def test_level_aware_handler_render_message(self):\n        \"\"\"Test that LevelAwareRichHandler customizes message rendering.\"\"\"\n        from gai.lib.logging import getLogger\n        \n        # Create logger which uses our custom handler\n        logger = getLogger(\"test.level.aware\")\n        handler = logger.handlers[0]\n        \n        # Check that it has the render_message method\n        assert hasattr(handler, 'render_message')\n        \n        # Create a mock log record\n        record = logging.LogRecord(\n            name=\"test\",\n            level=logging.INFO,\n            pathname=\"\",\n            lineno=0,\n            msg=\"Test message\",\n            args=(),\n            exc_info=None\n        )\n        \n        # Should be able to call render_message without error\n        try:\n            result = handler.render_message(record, \"Test message\")\n            # Result should be some kind of rich text object\n            assert result is not None\n        except Exception as e:\n            pytest.fail(f\"render_message should work without error: {e}\")\n\n\nclass TestLoggerConfiguration:\n    def test_formatter_configuration(self):\n        \"\"\"Test that the formatter is configured correctly.\"\"\"\n        logger = getLogger(\"test.formatter\")\n        handler = logger.handlers[0]\n        formatter = handler.formatter\n        \n        assert formatter is not None\n        assert formatter._fmt == \"%(message)s\"\n\n    def test_rich_handler_properties(self):\n        \"\"\"Test that RichHandler has expected properties set.\"\"\"\n        logger = getLogger(\"test.rich.props\")\n        handler = logger.handlers[0]\n        \n        # These properties should be set based on the configuration\n        # We can't directly access all of them, but we can verify the handler works\n        assert hasattr(handler, 'console')\n        \n        # The handler should be properly configured for Rich output\n        assert handler is not None\n\n    @patch.dict(os.environ, {\"LOG_LEVEL\": \"CRITICAL\"})\n    def test_high_log_level_filtering(self):\n        \"\"\"Test that high log levels properly filter lower level messages.\"\"\"\n        logger = getLogger(\"test.filter\")\n        \n        # With CRITICAL level, only critical messages should be processed\n        assert logger.level == logging.CRITICAL\n        \n        # Lower level messages should be filtered out\n        assert not logger.isEnabledFor(logging.ERROR)\n        assert not logger.isEnabledFor(logging.WARNING)\n        assert not logger.isEnabledFor(logging.INFO)\n        assert not logger.isEnabledFor(logging.DEBUG)\n        assert logger.isEnabledFor(logging.CRITICAL)\n\n    @patch.dict(os.environ, {\"LOG_LEVEL\": \"DEBUG\"})\n    def test_low_log_level_allows_all(self):\n        \"\"\"Test that DEBUG level allows all message types.\"\"\"\n        logger = getLogger(\"test.allow.all\")\n        \n        assert logger.level == logging.DEBUG\n        \n        # All levels should be enabled\n        assert logger.isEnabledFor(logging.DEBUG)\n        assert logger.isEnabledFor(logging.INFO)\n        assert logger.isEnabledFor(logging.WARNING)\n        assert logger.isEnabledFor(logging.ERROR)\n        assert logger.isEnabledFor(logging.CRITICAL)"
