                        "type": "tool_result",
                        "tool_use_id": "toolu_014tJy9brWSpuy6mWiD3Bj4f",
                        "content": "{\n  \"content\": \"\\\"\\\"\\\"\\nMocked objects for testing the gai.asm module.\\nThis file contains all the mocked dependencies for testing, focusing on proper mocking\\nof llm_client.chat.completions.create method.\\n\\\"\\\"\\\"\\n\\nfrom unittest.mock import Mock, AsyncMock, MagicMock\\nimport asyncio\\nfrom typing import AsyncGenerator, Any, Dict, List, Optional\\n\\n\\nclass MockLLMChunk:\\n    \\\"\\\"\\\"Mock chunk object for streaming responses.\\\"\\\"\\\"\\n\\n    def __init__(self, content: str):\\n        self.content = content\\n\\n    def extract(self):\\n        \\\"\\\"\\\"Mock extract method for chunks - returns the text content.\\\"\\\"\\\"\\n        return self.content\\n\\n\\nclass MockLLMResponse:\\n    \\\"\\\"\\\"Mock final response object that mimics LLM API responses.\\\"\\\"\\\"\\n\\n    def __init__(self, content: str = \\\"Hello! I'm a helpful assistant.\\\", tool_calls: Optional[List] = None):\\n        self.content = content\\n        self.tool_calls = tool_calls or []\\n\\n    def extract(self):\\n        \\\"\\\"\\\"Mock extract method that returns the response content.\\\"\\\"\\\"\\n        if self.tool_calls:\\n            return self.tool_calls\\n        return self.content\\n\\n    def copy(self):\\n        \\\"\\\"\\\"Mock copy method for the final response.\\\"\\\"\\\"\\n        return MockLLMResponse(content=self.content, tool_calls=self.tool_calls)\\n\\n\\nasync def mock_streaming_response():\\n    \\\"\\\"\\\"\\n    Mock async generator that simulates llm_client.chat.completions.create\\n    streaming response with hardcoded chunks.\\n    \\\"\\\"\\\"\\n    # Define hardcoded chunks - these are the text chunks that will be streamed\\n    hardcoded_chunks = [\\n        \\\"Hello\\\",\\n        \\\"! I'm\\\",\\n        \\\" Test_agent\\\",\\n        \\\", your\\\",\\n        \\\" helpful\\\",\\n        \\\" assistant\\\",\\n        \\\". How\\\",\\n        \\\" can I\\\",\\n        \\\" help you\\\",\\n        \\\" today?\\\",\\n    ]\\n\\n    # First yield all the text chunks\\n    for chunk_text in hardcoded_chunks:\\n        chunk = MockLLMChunk(chunk_text)\\n        yield chunk\\n\\n    # Finally yield a complete response (non-string) to end streaming\\n    # This simulates the final chunk that contains the complete message\\n    final_response = MockLLMResponse(\\n        \\\"Hello! I'm Test_agent, your helpful assistant. How can I help you today?\\\")\\n    yield final_response\\n\\n\\nclass MockChatCompletions:\\n    \\\"\\\"\\\"Mock chat completions interface that focuses on the create method.\\\"\\\"\\\"\\n\\n    async def create(self, model: str, messages: List, stream: bool = False, **kwargs):\\n        \\\"\\\"\\\"\\n        Mock create method for chat completions.\\n        This is the key method that needs to be mocked to return our hardcoded chunks.\\n        \\\"\\\"\\\"\\n        if stream:\\n            # Return our mock streaming response\\n            return mock_streaming_response()\\n        else:\\n            # For non-streaming, return a single response\\n            return MockLLMResponse(\\\"Hello! I'm Test_agent, your helpful assistant.\\\")\\n\\n\\nclass MockChatAPI:\\n    \\\"\\\"\\\"Mock chat API that contains the completions interface.\\\"\\\"\\\"\\n\\n    def __init__(self):\\n        self.completions = MockChatCompletions()\\n\\n\\nclass MockAsyncOpenAI:\\n    \\\"\\\"\\\"Mock AsyncOpenAI client for testing.\\\"\\\"\\\"\\n\\n    def __init__(self, config: Dict):\\n        self.config = config\\n        self.chat = MockChatAPI()\\n\\n\\nclass MockLLMGeneratorRetryPolicy:\\n    \\\"\\\"\\\"\\n    Mock retry policy for LLM operations. \\n    This just passes through the generator without modification.\\n    \\\"\\\"\\\"\\n\\n    def __init__(self, machine):\\n        self.machine = machine\\n\\n    async def run(self, generator_func):\\n        \\\"\\\"\\\"Mock run method that yields from the provided generator function.\\\"\\\"\\\"\\n        async for item in generator_func():\\n            yield item\\n\\n\\nclass MockMonologue:\\n    \\\"\\\"\\\"Mock monologue object for testing.\\\"\\\"\\\"\\n\\n    def __init__(self, agent_name: str = \\\"Test_agent\\\"):\\n        self.agent_name = agent_name\\n        self.messages = []\\n\\n    def add_user_message(self, state=None, content: str = \\\"\\\"):\\n        \\\"\\\"\\\"Mock method to add user message.\\\"\\\"\\\"\\n        self.messages.append({\\n            \\\"role\\\": \\\"user\\\",\\n            \\\"content\\\": content,\\n            \\\"state\\\": state.__class__.__name__ if state else None\\n        })\\n\\n    def add_assistant_message(self, state=None, content: Any = \\\"\\\"):\\n        \\\"\\\"\\\"Mock method to add assistant message.\\\"\\\"\\\"\\n        self.messages.append({\\n            \\\"role\\\": \\\"assistant\\\",\\n            \\\"content\\\": content,\\n            \\\"state\\\": state.__class__.__name__ if state else None\\n        })\\n\\n    def list_chat_messages(self):\\n        \\\"\\\"\\\"Mock method to list chat messages.\\\"\\\"\\\"\\n        return self.messages.copy()\\n\\n    def copy(self):\\n        \\\"\\\"\\\"Mock method to copy monologue.\\\"\\\"\\\"\\n        new_monologue = MockMonologue(self.agent_name)\\n        new_monologue.messages = self.messages.copy()\\n        return new_monologue\\n\\n\\nclass MockStateMachine:\\n    \\\"\\\"\\\"Mock state machine for testing states.\\\"\\\"\\\"\\n\\n    def __init__(self, user_message: str = \\\"Test message\\\", agent_name: str = \\\"Test_agent\\\"):\\n        self.user_message = user_message\\n        self.agent_name = agent_name\\n        self.state = \\\"CHAT\\\"\\n        self.state_manifest = {\\n            \\\"CHAT\\\": {\\n                \\\"module_path\\\": \\\"gai.asm.states\\\",\\n                \\\"class_name\\\": \\\"ChatState\\\",\\n                \\\"title\\\": \\\"CHAT\\\",\\n                \\\"input_data\\\": {\\n                    \\\"llm_config\\\": {\\\"type\\\": \\\"state_bag\\\", \\\"dependency\\\": \\\"llm_config\\\"},\\n                    \\\"recap\\\": {\\\"type\\\": \\\"state_bag\\\", \\\"dependency\\\": \\\"recap\\\"},\\n                },\\n                \\\"output_data\\\": [\\\"streamer\\\", \\\"get_assistant_message\\\"],\\n            }\\n        }\\n        self.state_history = []\\n        self.state_bag = {\\n            \\\"llm_config\\\": {\\n                \\\"model\\\": \\\"gpt-3.5-turbo\\\",\\n                \\\"api_key\\\": \\\"test-key\\\",\\n                \\\"base_url\\\": \\\"https://api.openai.com/v1\\\"\\n            },\\n            \\\"recap\\\": \\\"Previous conversation context\\\"\\n        }\\n        self.monologue = MockMonologue(agent_name)\\n\\n    def get_state_config(self, state_name: str):\\n        \\\"\\\"\\\"Get configuration for a specific state.\\\"\\\"\\\"\\n        return self.state_manifest.get(state_name, {})\\n\\n\\ndef create_mock_machine(user_message: str = \\\"Hello, how can you help me?\\\", agent_name: str = \\\"Test_agent\\\"):\\n    \\\"\\\"\\\"Factory function to create a mock state machine.\\\"\\\"\\\"\\n    return MockStateMachine(user_message=user_message, agent_name=agent_name)\\n\\n\\ndef create_mock_llm_config():\\n    \\\"\\\"\\\"Factory function to create mock LLM configuration.\\\"\\\"\\\"\\n    return {\\n        \\\"model\\\": \\\"gpt-3.5-turbo\\\",\\n        \\\"api_key\\\": \\\"test-api-key-123\\\",\\n        \\\"base_url\\\": \\\"https://api.openai.com/v1\\\",\\n        \\\"temperature\\\": 0.7,\\n        \\\"max_tokens\\\": 1000\\n    }\\n\\n\\ndef mock_async_openai_factory(client_config=None, **kwargs):\\n    \\\"\\\"\\\"Mock factory function for AsyncOpenAI.\\\"\\\"\\\"\\n    return MockAsyncOpenAI(client_config or kwargs)\\n\\n\\n# Mock patches for external dependencies - focusing on the specific method we need to mock\\nMOCK_PATCHES = {\\n    'gai.llm.openai.AsyncOpenAI': mock_async_openai_factory,\\n    'gai.llm.lib.LLMGeneratorRetryPolicy': MockLLMGeneratorRetryPolicy,\\n    'gai.messages.Monologue': MockMonologue,\\n}\\n\"\n}"
