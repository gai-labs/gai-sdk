e = chunk_data.get(\\\"usage\\\")\\n\\n\\nasync def mock_stream_generator():\\n    \\\"\\\"\\\"\\n    Mock async generator that returns hardcoded text chunks.\\n    This simulates the streaming response from OpenAI's API.\\n    \\\"\\\"\\\"\\n    # Hardcoded array of mock streaming chunks - this is the story we want to stream\\n    hardcoded_chunks = [\\n        {\\n            \\\"id\\\": \\\"chatcmpl-mock123\\\",\\n            \\\"choices\\\": [{\\n                \\\"delta\\\": {\\\"content\\\": \\\"\\\", \\\"role\\\": \\\"assistant\\\"},\\n                \\\"finish_reason\\\": None,\\n                \\\"index\\\": 0\\n            }],\\n            \\\"created\\\": 1721751236,\\n            \\\"model\\\": \\\"gpt-4-0613\\\",\\n            \\\"object\\\": \\\"chat.completion.chunk\\\"\\n        },\\n        {\\n            \\\"id\\\": \\\"chatcmpl-mock123\\\",\\n            \\\"choices\\\": [{\\n                \\\"delta\\\": {\\\"content\\\": \\\"Hello\\\"},\\n                \\\"finish_reason\\\": None,\\n                \\\"index\\\": 0\\n            }],\\n            \\\"created\\\": 1721751236,\\n            \\\"model\\\": \\\"gpt-4-0613\\\",\\n            \\\"object\\\": \\\"chat.completion.chunk\\\"\\n        },\\n        {\\n            \\\"id\\\": \\\"chatcmpl-mock123\\\",\\n            \\\"choices\\\": [{\\n                \\\"delta\\\": {\\\"content\\\": \\\"! I'm\\\"},\\n                \\\"finish_reason\\\": None,\\n                \\\"index\\\": 0\\n            }],\\n            \\\"created\\\": 1721751236,\\n            \\\"model\\\": \\\"gpt-4-0613\\\",\\n            \\\"object\\\": \\\"chat.completion.chunk\\\"\\n        },\\n        {\\n            \\\"id\\\": \\\"chatcmpl-mock123\\\",\\n            \\\"choices\\\": [{\\n                \\\"delta\\\": {\\\"content\\\": \\\" Test_agent\\\"},\\n                \\\"finish_reason\\\": None,\\n                \\\"index\\\": 0\\n            }],\\n            \\\"created\\\": 1721751236,\\n           