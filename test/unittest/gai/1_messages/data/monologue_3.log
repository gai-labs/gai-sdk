                        "input": {
                            "path": "/workspace/tests/gai-sdk/test_mock_stream.py",
                            "content": "\"\"\"\nUnit tests for mocking OpenAI streaming chat completions.\nThis test specifically focuses on mocking openai.chat.completions.create\nto return hardcoded streaming chunks instead of making actual API calls.\n\"\"\"\n\nimport pytest\nimport asyncio\nfrom unittest.mock import patch, AsyncMock, MagicMock\nfrom gai.llm.openai import AsyncOpenAI\nfrom dotenv import load_dotenv\nimport json\n\nload_dotenv()\n\n\nclass MockStreamChunk:\n    \"\"\"Mock chunk object that mimics OpenAI's streaming response format.\"\"\"\n    \n    def __init__(self, chunk_data):\n        \"\"\"Initialize with chunk data dictionary.\"\"\"\n        self.id = chunk_data.get(\"id\", \"mock-chatcmpl-123\")\n        self.choices = chunk_data.get(\"choices\", [])\n        self.created = chunk_data.get(\"created\", 1721751236)\n        self.model = chunk_data.get(\"model\", \"gpt-4-0613\")\n        self.object = chunk_data.get(\"object\", \"chat.completion.chunk\")\n        self.service_tier = chunk_data.get(\"service_tier\")\n        self.system_fingerprint = chunk_data.get(\"system_fingerprint\")\n        self.usage = chunk_data.get(\"usage\")\n\n\nasync def mock_stream_generator():\n    \"\"\"\n    Mock async generator that returns hardcoded text chunks.\n    This simulates the streaming response from OpenAI's API.\n    \"\"\"\n    # Hardcoded array of mock streaming chunks - this is the story we want to stream\n    hardcoded_chunks = [\n        {\n            \"id\": \"chatcmpl-mock123\",\n            \"choices\": [{\n                \"delta\": {\"content\": \"\", \"role\": \"assistant\"},\n                \"finish_reason\": None,\n                \"index\": 0\n            }],\n            \"created\": 1721751236,\n            \"model\": \"gpt-4-0613\",\n            \"object\": \"chat.completion.chunk\"\n        },\n        {\n            \"id\": \"chatcmpl-mock123\",\n            \"choices\": [{\n                \"delta\": {\"content\": \"Hello\"},\n                \"finish_reason\": None,\n                \"index\": 0\n            }],\n            \"created\": 1721751236,\n            \"model\": \"gpt-4-0613\",\n            \"object\": \"chat.completion.chunk\"\n        },\n        {\n            \"id\": \"chatcmpl-mock123\",\n            \"choices\": [{\n                \"delta\": {\"content\": \"! I'm\"},\n                \"finish_reason\": None,\n                \"index\": 0\n            }],\n            \"created\": 1721751236,\n            \"model\": \"gpt-4-0613\",\n            \"object\": \"chat.completion.chunk\"\n        },\n        {\n            \"id\": \"chatcmpl-mock123\",\n            \"choices\": [{\n                \"delta\": {\"content\": \" Test_agent\"},\n                \"finish_reason\": None,\n                \"index\": 0\n            }],\n            \"created\": 1721751236,\n            \"model\": \"gpt-4-0613\",\n            \"object\": \"chat.completion.chunk\"\n        },\n        {\n            \"id\": \"chatcmpl-mock123\",\n            \"choices\": [{\n                \"delta\": {\"content\": \", your\"},\n                \"finish_reason\": None,\n                \"index\": 0\n            }],\n            \"created\": 1721751236,\n            \"model\": \"gpt-4-0613\",\n            \"object\": \"chat.completion.chunk\"\n        },\n        {\n            \"id\": \"chatcmpl-mock123\",\n            \"choices\": [{\n                \"delta\": {\"content\": \" friendly\"},\n                \"finish_reason\": None,\n                \"index\": 0\n            }],\n            \"created\": 1721751236,\n            \"model\": \"gpt-4-0613\",\n            \"object\": \"chat.completion.chunk\"\n        },\n        {\n            \"id\": \"chatcmpl-mock123\",\n            \"choices\": [{\n                \"delta\": {\"content\": \" AI\"},\n                \"finish_reason\": None,\n                \"index\": 0\n            }],\n            \"created\": 1721751236,\n            \"model\": \"gpt-4-0613\",\n            \"object\": \"chat.completion.chunk\"\n        },\n        {\n            \"id\": \"chatcmpl-mock123\",\n            \"choices\": [{\n                \"delta\": {\"content\": \" assistant\"},\n                \"finish_reason\": None,\n                \"index\": 0\n            }],\n            \"created\": 1721751236,\n            \"model\": \"gpt-4-0613\",\n            \"object\": \"chat.completion.chunk\"\n        },\n        {\n            \"id\": \"chatcmpl-mock123\",\n            \"choices\": [{\n                \"delta\": {\"content\": \". I'm\"},\n                \"finish_reason\": None,\n                \"index\": 0\n            }],\n            \"created\": 1721751236,\n            \"model\": \"gpt-4-0613\",\n            \"object\": \"chat.completion.chunk\"\n        },\n        {\n            \"id\": \"chatcmpl-mock123\",\n            \"choices\": [{\n                \"delta\": {\"content\": \" here\"},\n                \"finish_reason\": None,\n                \"index\": 0\n            }],\n            \"created\": 1721751236,\n            \"model\": \"gpt-4-0613\",\n            \"object\": \"chat.completion.chunk\"\n        },\n        {\n            \"id\": \"chatcmpl-mock123\",\n            \"choices\": [{\n                \"delta\": {\"content\": \" to\"},\n                \"finish_reason\": None,\n                \"index\": 0\n            }],\n            \"created\": 1721751236,\n            \"model\": \"gpt-4-0613\",\n            \"object\": \"chat.completion.chunk\"\n        },\n        {\n            \"id\": \"chatcmpl-mock123\",\n            \"choices\": [{\n                \"delta\": {\"content\": \" help\"},\n                \"finish_reason\": None,\n                \"index\": 0\n            }],\n            \"created\": 1721751236,\n            \"model\": \"gpt-4-0613\",\n            \"object\": \"chat.completion.chunk\"\n        },\n        {\n            \"id\": \"chatcmpl-mock123\",\n            \"choices\": [{\n    