\\": [{\\n                \\\"delta\\\": {\\\"content\\\": None},\\n                \\\"finish_reason\\\": \\\"stop\\\",\\n                \\\"index\\\": 0\\n            }],\\n            \\\"created\\\": 1721751236,\\n            \\\"model\\\": \\\"gpt-4-0613\\\",\\n            \\\"object\\\": \\\"chat.completion.chunk\\\"\\n        }\\n    ]\\n    \\n    # Yield each chunk as a MockStreamChunk object\\n    for chunk_data in hardcoded_chunks:\\n        yield MockStreamChunk(chunk_data)\\n\\n\\n@pytest.mark.asyncio\\nasync def test_mock_openai_streaming():\\n    \\\"\\\"\\\"\\n    Test that demonstrates mocking openai.chat.completions.create\\n    to return hardcoded streaming chunks instead of making real API calls.\\n    \\\"\\\"\\\"\\n    \\n    # Create AsyncOpenAI instance (this uses the gai-sdk wrapper)\\n    openai_client = AsyncOpenAI()\\n    \\n    # Mock the original_openai_create method that the gai-sdk calls internally\\n    with patch.object(openai_client.chat.completions, 'original_openai_create', new_callable=AsyncMock) as mock_create:\\n        # Configure the mock to return our hardcoded stream\\n        mock_create.return_value = mock_stream_generator()\\n        \\n        # Make the call with streaming enabled\\n        response = await openai_client.chat.completions.create(\\n            model=\\\"gpt-4o\\\",\\n            messages=[{\\\"role\\\": \\\"user\\\", \\\"content\\\": \\\"Hello\\\"}],\\n            stream=True\\n        )\\n        \\n        # Collect all chunks from the stream\\n        collected_chunks = []\\n        collected_content = \\\"\\\"\\n        \\n        async for chunk in response:\\n            collected_chunks.append(chunk)\\n            # Extract content from each chunk using the gai-sdk's extract method\\n            if hasattr(chunk, 'extract'):\\n                extracted = chunk.extract()\\n                if isinstance(extracted, str) and extracted:\\n                    collected_content += extracted\\n                    print(f\\\"Chunk content: '{extracted}'\\\")\\n        \\n        # Verify that we got the expected chunks\\n        assert len(collected_chunks) > 0, \\\"Should have received streaming chunks\\\"\\n        \\n        # Verify that the mock was called\\n        mock_create.assert_called_once()\\n        \\n        # Verify the final assembled content matches our hardcoded message \\n        expected_content = \\\"Hello! I'm Test_agent, your friendly AI assistant. I'm here to help you with any questions or tasks you might have!\\\"\\n        assert collected_content == expected_content, f\\\"Expected '{expected_content}', got '{collected_content}'\\\"\\n        \\n        print(f\\\"\u2705 Successfully mocked OpenAI streaming with {len(collected_chunks)} chunks\\\")\\n        print(f\\\"\u2705 Final assembled content: '{collected_content}'\\\")\\n\\n\\n@pytest.mark.asyncio \\nasync def test_mock_openai_non_streaming():\\n    \\\"\\\"\\\"\\n    Test mocking openai.chat.completions.create for non-streaming responses.\\n    \\\"\\\"\\\"\\n    \\n    # Create a mock non-streaming response\\n    mock_response = MagicMock()\\n    mock_response.choices = [\\n        MagicMock(message=MagicMock(content=\\\"Hello! I'm Test_agent, ready to help you!\\\"))\\n    ]\\n    \\n    openai_client = AsyncOpenAI()\\n    \\n    with patch.object(openai_client.chat.completions, 'original_openai_create', new_callable=AsyncMock) as mock_create:\\n        mock_create.return_value = mock_response\\n        \\n        response = await openai_client.chat.completions.create(\\n            model=\\\"gpt-4o\\\",\\n            messages=[{\\\"role\\\": \\\"user\\\", \\\"content\\\": \\\"Hello\\\"}],\\n            stream=False\\n        )\\n        \\n        # Verify the response - it gets processed by attach_extractor_async\\n        # So we need to check the extract method\\n        content = response.extract()\\n        assert \\\"Test_agent\\\" in str(content), f\\\"Expected 'Test_agent' in response, got: {content}\\\"\\n        mock_create.assert_called_once()\\n        \\n        print(\\\"\u2705 Successfully mocked OpenAI non-streaming response\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    # Allow running the test directly\\n    pytest.main([__file__])\"\n}"
